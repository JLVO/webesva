---
// Footer.astro (o Footer.jsx si usas React)
import {
  Facebook,
  Instagram,
  Mail,
  Phone,
  Linkedin,
  Youtube,
  MessageCircle,
  Camera,
  Fingerprint,
  Laptop,
  Server,
  Wifi,
  Lightbulb,
  Satellite,
  MapPin,
  Clock
} from 'lucide-react';
---

<style>
       
        .footer-link {
            position: relative;
            display: inline-block;
            padding-bottom: 2px;
        }
        .footer-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background-color: #3b82f6;
            transition: width 0.3s ease;
        }
        .footer-link:hover::after {
            width: 100%;
        }
        
        .contact-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            transition: all 0.3s ease;
            margin-bottom: 16px;
        }
        .contact-item:hover {
            color: #3b82f6;
        }
        .contact-icon {
            min-width: 24px;
            text-align: center;
            margin-top: 2px;
        }
        .contact-text {
            flex: 1;
        }
       
        .footer-container {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 30px rgba(0, 0, 0, 0.15);
            max-width: 1200px;
            width: 100%;
        }
    </style>

<footer class="bg-gray-900 text-white py-10 px-4">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-5 gap-10">

    <!-- Columna 1: Logo + Descripción -->
    <div>
      <img src="/LogoEsvaBlanco.svg" alt="Logo ESVA" class="w-48 mb-4 mx-auto block" width="192" height="66" loading="lazy" />
      <p class="text-gray-300">
        Seguridad y Protección a tu alcance. Soluciones en soporte técnico, biometría y videovigilancia para empresas y hogares en todo Perú.
      </p>
    </div>

    <!-- Columna 2: Enlaces rápidos -->
    <div>
      <h3 class="text-lg font-semibold mb-6 pb-2 border-b border-gray-700">Enlaces rápidos</h3>
      <ul class="space-y-2 text-gray-300">
        <li><a href="/" class="footer-link text-gray-300 hover:text-white">Inicio</a></li>
        <li><a href="/nosotros/" class="footer-link text-gray-300 hover:text-white">Nosotros</a></li>
        <li><a href="/brochure/" class="footer-link text-gray-300 hover:text-white">Brochure</a></li>
        <li><a href="/servicios/" class="footer-link text-gray-300 hover:text-white">Servicios</a></li>
        <li><a href="/blog/" class="footer-link text-gray-300 hover:text-white">Blog</a></li>
        <li><a href="#faq" class="footer-link text-gray-300 hover:text-white">Preguntas Frecuentes</a></li>
        <li><a href="/contactanos/" class="footer-link text-gray-300 hover:text-white">Contáctanos</a></li>
      </ul>
    </div>

    <!-- Servicios -->
                        <div>
                            <h3 class="text-lg font-semibold mb-6 pb-2 border-b border-gray-700">Nuestros Servicios</h3>
                            <ul class="space-y-3">
                                <li class="flex items-center">
                                    <Camera className="w-5 h-5 text-accent mr-2" />
                                    <a href="/servicios/camaras-de-seguridad/" class="footer-link text-gray-300 hover:text-white">Videovigilancia</a>
                                </li>
                                <li class="flex items-center">
                                    <Fingerprint className="w-5 h-5 text-accent mr-2" />
                                    <a href="/servicios/lectores-biometricos/" class="footer-link text-gray-300 hover:text-white">Control de Acceso</a>
                                </li>
                                <li class="flex items-center">
                                    <Laptop className="w-5 h-5 text-accent mr-2" />
                                    <a href="/servicios/soporte-tecnico/" class="footer-link text-gray-300 hover:text-white">Soporte Técnico</a>
                                </li>
                                <li class="flex items-center">
                                    <Server className="w-5 h-5 text-accent mr-2" />
                                    <a href="/servicios/redes-conectividad/" class="footer-link text-gray-300 hover:text-white">Infraestructura TI</a>
                                </li>
                                <li class="flex items-center">
                                    <Wifi className="w-5 h-5 text-accent mr-2" />
                                    <a href="/servicios/redes-conectividad/" class="footer-link text-gray-300 hover:text-white">Redes y Comunicación</a>
                                </li>
                                <li class="flex items-center">
                                    <Satellite className="w-5 h-5 text-accent mr-2" />
                                    <a href="/servicios/starlink/" class="footer-link text-gray-300 hover:text-white">Starlink (Standard/Mini)</a>
                                </li>
                                <li class="flex items-center">
                                    <Lightbulb className="w-5 h-5 text-accent mr-2" />
                                    <span class="text-gray-300">Automatización</span>
                                </li>
                            </ul>
                        </div>

   <!-- Contacto y Redes -->
                        <div>
                            <h3 class="text-lg font-semibold mb-6 pb-2 border-b border-gray-700">Contáctanos</h3>
                            
                            <div class="mb-8">
                                <!-- Corrección: Texto al costado del ícono -->
                                <div class="contact-item">
                                    <div class="contact-icon">
                                        <MapPin className="w-5 h-5 text-accent" />
                                    </div>
                                    <div class="contact-text">
                                        <p class="font-medium">Oficina Principal</p>
                                        <p class="text-gray-300">Piura, Perú</p>
                                    </div>
                                </div>
                                
                                <div class="contact-item">
                                    <div class="contact-icon">
                                        <Phone className="w-5 h-5 text-accent" />
                                    </div>
                                    <div class="contact-text">
                                        <p class="font-medium">Teléfono</p>
                                        <a href="tel:+51985834886" class="text-gray-300 hover:text-white">+51 985 834 886</a>
                                    </div>
                                </div>
                                
                                <div class="contact-item">
                                    <div class="contact-icon">
                                        <Mail className="w-5 h-5 text-accent" />
                                    </div>
                                    <div class="contact-text">
                                        <p class="font-medium">Correo</p>
                                        <a href="mailto:contacto@esva.pe" class="text-gray-300 hover:text-white">contacto@esva.pe</a>
                                    </div>
                                </div>
                                
                                <div class="contact-item">
                                    <div class="contact-icon">
                                        <Clock className="w-5 h-5 text-accent" />
                                    </div>
                                    <div class="contact-text">
                                        <p class="font-medium">Horario</p>
                                        <p class="text-gray-300">Lun-Vie: 8:00 AM - 6:00 PM</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                            
                            

    <!-- Columna 4: Redes sociales -->
    {/* Columna 4: Redes sociales */}
<div>
  <h3 class="text-lg font-semibold mb-6 pb-2 border-b border-gray-700">Síguenos en redes</h3>
  <p class="text-gray-300 mb-4">Conéctate con nosotros y entérate de nuestras novedades y servicios.</p>
  <div class="flex gap-4 text-2xl">
    <a
      href="https://wa.me/51985834886"
      target="_blank"
      class="text-gray-400 hover:text-green-500 transition"
      aria-label="WhatsApp"
    >
      <MessageCircle className="w-6 h-6" />
    </a>
    <a
      href="https://www.facebook.com/esva2022"
      target="_blank"
      class="text-gray-400 hover:text-blue-500 transition"
      aria-label="Facebook"
    >
      <Facebook className="w-6 h-6" />
    </a>
    <a
      href="https://www.instagram.com/esva.soluciones/"
      target="_blank"
      class="text-gray-400 hover:text-pink-500 transition"
      aria-label="Instagram"
    >
      <Instagram className="w-6 h-6" />
    </a>
    <a
      href="mailto:contacto@esva.pe"
      class="text-gray-400 hover:text-yellow-400 transition"
      aria-label="Correo"
    >
      <Mail className="w-6 h-6" />
    </a>
    <a
      href="https://www.linkedin.com/company/94254191/"
      target="_blank"
      class="text-gray-400 hover:text-sky-500 transition"
      aria-label="LinkedIn"
    >
      <Linkedin className="w-6 h-6" />
    </a>
    <a
      href="https://www.youtube.com/@esvasoluciones"
      target="_blank"
      class="text-gray-400 hover:text-red-500 transition"
      aria-label="YouTube"
    >
      <Youtube className="w-6 h-6" />
    </a>
  </div>

  

</div>

  </div>

  <!-- Línea inferior -->
                    <div class="border-t border-gray-800 mt-12 pt-6">
                        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                            <p class="text-center text-gray-400">
                                © 2026 ESVA Seguridad. Todos los derechos reservados.
                            </p>
                            <div class="flex gap-6">
                                <a href="/terminos-y-condiciones/" class="text-gray-400 hover:text-white text-sm">Términos y Condiciones</a>
                                <a href="/politica-de-privacidad/" class="text-gray-400 hover:text-white text-sm">Política de Privacidad</a>
                                <a href="/politica-de-cookies/" class="text-gray-400 hover:text-white text-sm">Política de Cookies</a>
                            </div>
                        </div>
                    </div>
                </div>
</footer>
