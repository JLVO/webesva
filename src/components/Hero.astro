---
// Hero.astro
const { title, subtitle, imageUrl, buttonText, buttonLink, linkwhatsapp, flushTop = false, imageMaxWidth = 'max-w-lg', sectionPadding = 'py-12 md:py-16' } = Astro.props;
const imageContainerClass = `animate-fade-in-right flex justify-center ${flushTop ? 'md:pt-12' : ''}`;
const imageClass = `w-full ${imageMaxWidth}`;
---

<section 
  class={`relative text-white overflow-hidden ${sectionPadding}`}
  style="background-image: url('/bg-nosotros.avif'); background-position: right; background-repeat: no-repeat; background-size: cover;"
>
  <!-- Capa azul semitransparente -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-secondary/80 z-0"></div>

  <!-- Contenido principal -->
  <div class="relative z-10 max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
    
    <!-- Texto -->
    <div class="animate-fade-in-left">
      <h1 class="text-4xl font-extrabold mb-4 leading-tight drop-shadow-lg">
        {title}
      </h1>
      <p class="text-lg mb-8 drop-shadow">
        {subtitle}
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/contactanos/" class="bg-primary text-white px-6 py-3 rounded-lg font-semibold shadow-md hover:bg-secondary transition">
          {buttonText}
        </a>
        <a href={linkwhatsapp} target="_blank"
           class="bg-accent-green text-white px-6 py-3 rounded-lg font-semibold shadow-md hover:bg-accent-green/80 transition">
          {buttonLink}
        </a>
      </div>
    </div>

    <!-- Imagen -->
    <div class={imageContainerClass}>
      <img src={imageUrl} alt="Soporte técnico y seguridad" class={imageClass} loading="lazy" />
    </div>

  </div>
</section>
