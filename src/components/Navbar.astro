--- 
import logo from '../assets/LogoEsva.svg';
---
<nav class="bg-white text-black shadow-md sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-24 items-center">
      
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/">
          <img src={logo.src} alt="Logo ESVA" class="h-20 w-auto" />
        </a>
      </div>

      <!-- Menú de navegación (escritorio) -->
      <div class="hidden md:flex space-x-8 font-semibold text-base items-center">
        <a href="/" class="hover:text-blue-600 transition duration-300">Inicio</a>
        <a href="/nosotros/" class="hover:text-blue-600 transition duration-300">Nosotros</a>

        <!-- Dropdown Servicios -->
        <div class="relative group">
          <a href="/servicios/" class="inline-block hover:text-blue-600 transition duration-300">
            Servicios
          </a>
        
          <div class="absolute left-0 mt-2 w-64 bg-white border rounded-lg shadow-lg z-50
                      invisible opacity-0 group-hover:visible group-hover:opacity-100 
                      transform group-hover:translate-y-0 transition-all duration-300 flex flex-col">
            
            <a href="/servicios/mantenimiento-reparacion-informatica/" class="block px-5 py-3 hover:bg-gray-100 transition-colors duration-200">Mantenimiento y Reparación</a>
            <a href="/servicios/formateo-instalacion/" class="block px-5 py-3 hover:bg-gray-100 transition-colors duration-200">Formateo e Instalación</a>
            <a href="/servicios/recuperacion-datos/" class="block px-5 py-3 hover:bg-gray-100 transition-colors duration-200">Recuperación de Datos</a>
            <a href="/servicios/redes-conectividad/" class="block px-5 py-3 hover:bg-gray-100 transition-colors duration-200">Redes y Conectividad</a>
            <a href="/servicios/mantenimiento-preventivo/" class="block px-5 py-3 hover:bg-gray-100 transition-colors duration-200">Mantenimiento Preventivo</a>
            
            <!-- Submenú de Seguridad Electrónica -->
            <div class="border-t border-gray-200 my-1"></div>
            <span class="px-5 py-2 text-sm font-semibold text-gray-500">Seguridad Electrónica</span>
            <a href="/servicios/camaras-de-seguridad/" class="block pl-8 pr-5 py-3 hover:bg-gray-100 transition-colors duration-200">Cámaras de Seguridad</a>
            <a href="/servicios/lectores-biometricos/" class="block pl-8 pr-5 py-3 hover:bg-gray-100 transition-colors duration-200">Lectores Biométricos</a>
          </div>
        </div>

        <a href="/blog/" class="hover:text-blue-600 transition duration-300">Blog</a>

        <a href="/contactanos/" class="hover:text-blue-600 transition duration-300">Contacto</a>
      </div>

      <!-- Botón móvil (hamburguesa) -->
      <div class="md:hidden">
        <button aria-label="Abrir menú" class="hover:text-hover transition">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>
