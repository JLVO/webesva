--- 
import logo from '../assets/LogoEsva.svg';
---
<nav class="bg-white text-black shadow-md sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-24 items-center">
      
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/">
          <img src={logo.src} alt="Logo ESVA" class="h-20 w-auto" />
        </a>
      </div>

      <!-- Menú de navegación (escritorio) -->
      <div class="hidden md:flex space-x-8 font-semibold text-base items-center">
        <a href="/" class="hover:text-blue-600 transition duration-300">Inicio</a>
        <a href="/nosotros" class="hover:text-blue-600 transition duration-300">Nosotros</a>

        <!-- Dropdown Servicios -->
        <div class="relative group">
          <a href="/servicios" class="inline-block hover:text-blue-600 transition duration-300">
            Servicios
          </a>
        
          <div class="absolute left-0 mt-2 w-56 bg-white border rounded shadow-lg z-50
                      invisible opacity-0 group-hover:visible group-hover:opacity-100 
                      group-hover:translate-y-0 transition-all duration-300 flex flex-col">
            
            <a href="/servicios/mantenimiento-reparacion-informatica" class="block px-4 py-2 hover:bg-blue-100">Mantenimiento y Reparación</a>
            <a href="/servicios/formateo-instalacion" class="block px-4 py-2 hover:bg-blue-100">Formateo e Instalación</a>
            <a href="/servicios/recuperacion-datos" class="block px-4 py-2 hover:bg-blue-100">Recuperación de Datos</a>
            <a href="/servicios/redes-conectividad" class="block px-4 py-2 hover:bg-blue-100">Redes y Conectividad</a>
            <a href="/servicios/mantenimiento-preventivo" class="block px-4 py-2 hover:bg-blue-100">Mantenimiento Preventivo</a>
            
            <!-- Submenú de Seguridad Electrónica -->
            <div class="relative group/seguridad">
              <a href="#" class="block px-4 py-2 hover:bg-blue-100 flex justify-between items-center">
                Seguridad Electrónica
                <svg class="w-4 h-4 inline-block ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </a>
              <div class="absolute left-full top-0 mt-0 w-56 bg-white border rounded shadow-lg z-50
                          invisible opacity-0 group-hover/seguridad:visible group-hover/seguridad:opacity-100 
                          transition-all duration-300 flex flex-col">
                <a href="/servicios/camaras-de-seguridad" class="block px-4 py-2 hover:bg-blue-100">Cámaras de Seguridad</a>
                <a href="/servicios/lectores-biometricos" class="block px-4 py-2 hover:bg-blue-100">Lectores Biométricos</a>
              </div>
            </div>
          </div>
        </div>

<a href="/blog" class="hover:text-blue-600 transition duration-300">Blog</a>

        <a href="/contactanos" class="hover:text-blue-600 transition duration-300">Contacto</a>
      </div>

      <!-- Botón móvil (hamburguesa) -->
      <div class="md:hidden">
        <button id="mobile-menu-button" aria-label="Abrir menú" class="hover:text-hover transition">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden md:hidden">
    <a href="/" class="block py-2 px-4 text-sm hover:bg-gray-200">Inicio</a>
    <a href="/nosotros" class="block py-2 px-4 text-sm hover:bg-gray-200">Nosotros</a>
    <div>
      <button id="mobile-services-button" class="w-full text-left block py-2 px-4 text-sm hover:bg-gray-200 flex justify-between items-center">
        <span>Servicios</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </button>
      <div id="mobile-submenu" class="hidden pl-4">
        <a href="/servicios/mantenimiento-reparacion-informatica" class="block py-2 px-4 text-sm hover:bg-gray-200">Mantenimiento y Reparación</a>
        <a href="/servicios/formateo-instalacion" class="block py-2 px-4 text-sm hover:bg-gray-200">Formateo e Instalación</a>
        <a href="/servicios/recuperacion-datos" class="block py-2 px-4 text-sm hover:bg-gray-200">Recuperación de Datos</a>
        <a href="/servicios/redes-conectividad" class="block py-2 px-4 text-sm hover:bg-gray-200">Redes y Conectividad</a>
        <a href="/servicios/mantenimiento-preventivo" class="block py-2 px-4 text-sm hover:bg-gray-200">Mantenimiento Preventivo</a>
        <div>
          <button id="mobile-security-button" class="w-full text-left block py-2 px-4 text-sm hover:bg-gray-200 flex justify-between items-center">
            <span>Seguridad Electrónica</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div id="mobile-security-submenu" class="hidden pl-4">
            <a href="/servicios/camaras-de-seguridad" class="block py-2 px-4 text-sm hover:bg-gray-200">Cámaras de Seguridad</a>
            <a href="/servicios/lectores-biometricos" class="block py-2 px-4 text-sm hover:bg-gray-200">Lectores Biométricos</a>
          </div>
        </div>
      </div>
    </div>
    <a href="/blog" class="block py-2 px-4 text-sm hover:bg-gray-200">Blog</a>
    <a href="/contactanos" class="block py-2 px-4 text-sm hover:bg-gray-200">Contacto</a>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileServicesButton = document.getElementById('mobile-services-button');
  const mobileSubmenu = document.getElementById('mobile-submenu');
  const mobileSecurityButton = document.getElementById('mobile-security-button');
  const mobileSecuritySubmenu = document.getElementById('mobile-security-submenu');

  mobileMenuButton.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
  });

  mobileServicesButton.addEventListener('click', (e) => {
    e.preventDefault();
    mobileSubmenu.classList.toggle('hidden');
  });

  mobileSecurityButton.addEventListener('click', (e) => {
    e.preventDefault();
    mobileSecuritySubmenu.classList.toggle('hidden');
  });
</script>
