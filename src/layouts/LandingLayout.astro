---
import BaseLayout from './BaseLayout.astro';

const { 
  pageTitle, 
  title,
  metaDescription, 
  description,
  ogImage, 
  canonicalUrl, 
  canonical,
  showNavbar, 
  showFooter, 
  mainPadding 
} = Astro.props;
---
<BaseLayout 
  pageTitle={pageTitle || title} 
  metaDescription={metaDescription || description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl || canonical}
  showNavbar={showNavbar}
  showFooter={showFooter}
  mainPadding={mainPadding}
>
  <div class="relative min-h-screen w-full overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 -z-10"></div>
    <div class="absolute top-0 left-0 w-full h-full bg-cover bg-center opacity-5" style="background-image: url('/imagenes/blog/centro-operaciones-esva.webp');"></div>
    <div class="relative z-10">
      <slot />
    </div>
  </div>
</BaseLayout>