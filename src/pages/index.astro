      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Descubre Nuestro Blog Técnico</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
