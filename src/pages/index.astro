    </p>

    <div class="bg-gray-50 p-8 rounded-xl shadow-md">

      <input 
        type="number" 
        id="equipos" 
        placeholder="Cantidad de equipos"
        class="w-full md:w-1/2 p-3 border rounded-lg mb-4 text-center"
      />

      <br>

      <button 
        onclick="calcularPlan()" 
        class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg">
        Calcular Plan
      </button>

      <!-- Resultado -->
      <div id="resultado" class="mt-8 hidden">
        <h3 id="planNombre" class="text-2xl font-bold text-blue-700"></h3>
        <p id="precio" class="text-3xl font-bold text-gray-900 mt-2"></p>
        <p id="descripcion" class="text-gray-600 mt-2"></p>

        <a id="whatsappBtn" target="_blank"
          class="inline-block mt-6 bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg">
