<script>
window.calcularPlan = function () {
  const input = document.getElementById("equipos");
  if (!input) return;

  const equipos = parseInt(input.value);
  if (!equipos) return;

  let precio = 200 + (equipos * 35);

  let plan = "";
  let precioFinal = 0;

  if (equipos <= 5) {
    plan = "Plan Esencial";
    precioFinal = Math.max(precio, 550);
  } else if (equipos <= 15) {
    plan = "Plan Profesional";
    precioFinal = Math.max(precio, 1550);
  } else {
    plan = "Plan Empresarial";
    precioFinal = Math.max(precio, 2500);
  }

  const resultado = document.getElementById("resultado");
  const planNombre = document.getElementById("planNombre");
  const precioTexto = document.getElementById("precio");

  if (resultado && planNombre && precioTexto) {
    resultado.classList.remove("hidden");
    planNombre.innerText = plan;
    precioTexto.innerText = "S/ " + precioFinal + " / mes";
  }
};
</script>


