                    <p class="text-sm text-gray-500 mt-1">Lunes a Sábado: 8:00 AM - 6:00 PM</p>
                  </div>
                </div>
                
                <!-- Email -->
                <div class="flex items-start">
                  <div class="bg-blue-100 p-3 rounded-full mr-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-800 mb-1">Correo electrónico</h3>
                    <p class="text-gray-600">
                      <a href="mailto:contacto@esva.pe" class="text-blue-600 hover:underline">contacto@esva.pe</a>
                    </p>
                    <p class="text-sm text-gray-500 mt-1">Respuesta en menos de 24 horas</p>
                  </div>
                </div>
                
                <!-- Location -->
                <!-- <div class="flex items-start">
                  <div class="bg-blue-100 p-3 rounded-full mr-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                   <div>
                    <h3 class="font-semibold text-gray-800 mb-1">Ubicación</h3>
                    <p class="text-gray-600">Av. Grau 123, Piura, Perú</p>
                    <p class="text-sm text-gray-500 mt-1">Visítanos en nuestro local con cita previa</p>
                  </div> 
                </div> -->
              </div>
            </div>
            
            <!-- Services -->
            <div class="mb-10">
              <h2 class="text-2xl font-bold text-gray-800 mb-6">Servicios ESVA</h2>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-blue-50 p-4 rounded-lg">
                  <div class="flex items-center">
                    <div class="bg-blue-100 p-2 rounded-lg mr-3">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <span class="text-sm font-medium text-gray-800">Soporte Técnico</span>
                  </div>
                </div>
                
                <div class="bg-blue-50 p-4 rounded-lg">
                  <div class="flex items-center">
                    <div class="bg-blue-100 p-2 rounded-lg mr-3">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
