---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Contáctanos | ESVA - Soporte Técnico y Seguridad Electrónica" metaDescription="Contácta a ESVA para soporte técnico, instalación de redes, seguridad electrónica y mantenimiento de equipos en Piura. Soluciones profesionales para empresas." canonicalUrl={Astro.url.href} ogType="website" mainPadding={false}>
      
      <!-- Hero Section -->
      <section class="bg-gradient-to-r from-blue-900 to-indigo-900 py-16 md:py-24 px-4 text-center">
        <div class="max-w-4xl mx-auto">
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Contácta a ESVA</h1>
          <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
            Soluciones tecnológicas y de seguridad para tu empresa en Piura
          </p>
          <div class="inline-flex items-center bg-blue-800 text-white px-6 py-3 rounded-full font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            <span>Línea directa: <a href="tel:+51985834886" class="font-bold">985 834 886</a></span>
          </div>
        </div>
      </section>
      
      <!-- Contact Section -->
      <section class="py-16 px-4 md:px-8 bg-white">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Contact Form -->
          <div class="bg-gray-50 p-8 rounded-2xl shadow-lg">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Envíanos un mensaje</h2>
            <p class="text-gray-600 mb-8">
              Completa el formulario y nuestro equipo se pondrá en contacto contigo a la brevedad.
            </p>
            
            <form id="contacto-form" class="space-y-6">
              <div>
                <label for="nombre" class="block text-sm font-medium text-gray-700 mb-2">Nombre completo *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  placeholder="Tu nombre completo"
                  class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  required
                />
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="correo" class="block text-sm font-medium text-gray-700 mb-2">Correo electrónico *</label>
                  <input
                    type="email"
                    id="correo"
                    name="correo"
                    placeholder="tu@correo.com"
                    class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    required
                  />
                </div>
                
                <div>
                  <label for="telefono" class="block text-sm font-medium text-gray-700 mb-2">Teléfono / WhatsApp</label>
                  <input
                    type="tel"
                    id="telefono"
                    name="telefono"
                    placeholder="Ej: 985 834 886"
                    class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>
              </div>
              
              <div>
                <label for="servicio" class="block text-sm font-medium text-gray-700 mb-2">Servicio de interés</label>
                <select id="servicio" name="servicio" class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                  <option value="">Selecciona un servicio</option>
                  <option value="soporte">Soporte Técnico</option>
                  <option value="redes">Instalación de Redes</option>
                  <option value="seguridad">Seguridad Electrónica</option>
                  <option value="mantenimiento">Mantenimiento Preventivo</option>
                  <option value="recuperacion">Recuperación de Datos</option>
                  <option value="domicilio">Servicio a Domicilio</option>
                </select>
              </div>
              
              <div>
                <label for="mensaje" class="block text-sm font-medium text-gray-700 mb-2">Mensaje *</label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="5"
                  placeholder="Cuéntanos cómo podemos ayudarte..."
                  class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  required
                ></textarea>
              </div>
              
              <!-- Alert Containers -->
              <div id="form-success" class="hidden p-4 rounded-xl bg-green-50 text-green-700 border border-green-200 text-sm font-medium">
                ¡Tu mensaje ha sido enviado con éxito! Nos pondremos en contacto contigo pronto.
              </div>
              <div id="form-error" class="hidden p-4 rounded-xl bg-red-50 text-red-700 border border-red-200 text-sm font-medium">
                Ocurrió un error al enviar tu mensaje. Por favor, inténtalo de nuevo.
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-blue-600 text-white px-6 py-4 rounded-xl shadow hover:bg-blue-700 transition font-medium text-lg flex items-center justify-center gap-2"
