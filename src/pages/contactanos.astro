                <span>Enviar mensaje</span>
                <span id="loading-spinner" class="hidden w-5.5 h-5.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
              </button>
            </form>
          </div>
          
          <!-- Contact Information -->
          <div>
            <div class="mb-10">
              <h2 class="text-2xl font-bold text-gray-800 mb-6">Información de contacto</h2>
              <p class="text-gray-600 mb-8">
                Estamos disponibles para responder tus consultas y brindarte soluciones tecnológicas personalizadas.
              </p>
              
              <div class="space-y-6">
                <!-- Phone -->
                <div class="flex items-start">
                  <div class="bg-blue-100 p-3 rounded-full mr-4">
