---
import PresentacionLayout from '../../../layouts/PresentacionLayout.astro';
---

<PresentacionLayout
  pageTitle="¿Qué es el Spoofing?"
  currentPage={5}
  totalPages={12}
  prevPage="/capacitacion/ciberseguridad/ejemplos-phishing-inmobiliario"
  nextPage="/capacitacion/ciberseguridad/actividad-interactiva"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
    <!-- Columna de Texto -->
    <div class="prose prose-lg max-w-none">
      <h1 class="text-4xl font-bold text-gray-800">¿Qué es el Spoofing?</h1>
      <p>
        El <strong class="text-red-600">spoofing</strong> (o suplantación) es la técnica que usan los delincuentes para <strong class="text-red-600">falsificar su identidad</strong> y hacerse pasar por alguien de confianza (un jefe, un banco, un cliente).
      </p>
      <p>
        Es el motor que hace que el phishing sea convincente.
      </p>
      <h3 class="font-semibold">Tipos Comunes de Spoofing:</h3>
      <ul>
        <li><strong>Email Spoofing:</strong> Falsifican el correo del remitente.</li>
        <li><strong>Website Spoofing:</strong> Crean webs falsas que imitan a las reales.</li>
        <li><strong>Caller ID Spoofing:</strong> Falsifican el número de teléfono que te llama.</li>
      </ul>
    </div>

    <!-- Columna de Video -->
    <div class="aspect-w-16 aspect-h-9">
      <!-- 
        REEMPLAZAR ESTE ENLACE: 
        Aquí puedes poner el enlace de tu video de YouTube sobre Spoofing.
      -->
      <iframe 
        class="w-full h-full rounded-lg shadow-2xl"
        src="https://www.youtube.com/embed/2t-9djQvnKQ?si=75kssQOUiHG_eg3z&amp;controls=0"
        title="YouTube video player" 
        frameborder="0" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        referrerpolicy="strict-origin-when-cross-origin" 
        allowfullscreen
      ></iframe>
    </div>
  </div>
</PresentacionLayout>