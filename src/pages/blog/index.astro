---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return true; // Mostrar todos los posts
});

allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

// 1. Definir la jerarquía de categorías
const categoriesHierarchy: Record<string, string[]> = {
  "Soporte Técnico": [
    "Mantenimiento y Reparación",
    "Instalación de Redes",
    "Soporte Técnico",
    "Mantenimiento Preventivo",
    "Recuperación de Datos",
    "Servicio a Domicilio"
  ],
  "Seguridad Electrónica": [
    "Cámaras de Seguridad",
    "Lectores Biométricos"
  ]
};

// Crear mapa de subcategoría a categoría principal con tipos definidos
const subToMain: Record<string, string> = {};
for (const [mainCat, subCats] of Object.entries(categoriesHierarchy)) {
  subCats.forEach(subCat => {
    subToMain[subCat] = mainCat;
  });
}

// Crear un nuevo array de posts con la propiedad mainCategory
const postsWithMainCategory = allPosts.map(post => {
  let mainCatForPost = null;
  if (post.data.tags) {
    for (const tag of post.data.tags) {
      if (subToMain[tag]) {
        mainCatForPost = subToMain[tag];
        break; // Tomar la primera categoría principal encontrada
      }
    }
  }
  return {
    ...post,
    mainCategory: mainCatForPost
  };
});

// 2. Crear lista plana de todas las subcategorías
const allSubcategories: string[] = [];
Object.values(categoriesHierarchy).forEach(subcats => {
  allSubcategories.push(...subcats);
});

// 3. Contar posts por categoría - SOLUCIÓN AL ERROR: Definir tipo explícito
const categoryCounts: Record<string, number> = {};
postsWithMainCategory.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      if (allSubcategories.includes(tag)) {
        categoryCounts[tag] = (categoryCounts[tag] || 0) + 1;
      }
    });
  }
});

// 4. Obtener categoría seleccionada
const selectedCategory = Astro.url.searchParams.get('categoria');

// 5. Filtrar posts si se seleccionó una categoría
let filteredPosts = postsWithMainCategory;
if (selectedCategory) {
  filteredPosts = postsWithMainCategory.filter(post => 
    post.data.tags && post.data.tags.includes(selectedCategory)
  );
}

// 6. Determinar categoría principal seleccionada
let selectedMainCategory: string | null = null;
if (selectedCategory) {
  for (const [mainCat, subCats] of Object.entries(categoriesHierarchy)) {
    if (subCats.includes(selectedCategory)) {
      selectedMainCategory = mainCat;
      break;
    }
  }
}

const pageTitle = selectedCategory 
  ? `Blog - ${selectedCategory.charAt(0).toUpperCase() + selectedCategory.slice(1)}` 
  : "Blog";

const metaDescription = selectedCategory 
  ? `Artículos y noticias sobre ${selectedCategory} en el blog de ESVA.`
  : "Lee nuestras últimas noticias y artículos sobre seguridad y soporte técnico.";
---

<BaseLayout pageTitle={pageTitle} metaDescription={metaDescription} canonicalUrl="https://esva.pe/blog/">
  <BreadcrumbSchema items={[
    { name: "Inicio", url: "https://esva.pe/" },
    { name: "Blog", url: "https://esva.pe/blog/" }
  ]} />
  <div class="container mx-auto pt-1 pb-8 px-6">
    
    <div class="flex flex-col md:flex-row gap-8 lg:gap-12">
      <!-- Sidebar de Categorías con Jerarquía -->
      <aside class="w-full md:w-1/4 lg:w-1/5 md:sticky md:top-28 self-start bg-white p-4 rounded-lg shadow-sm md:max-h-[calc(100vh-9rem)] md:overflow-y-auto">
        <h2 class="text-xl font-semibold mb-4 text-gray-800 border-b pb-2">Categorías</h2>
        <ul class="space-y-2">
          <li>
            <a 
              href="/blog/" 
              class="category-link block px-3 py-2 rounded-md text-sm font-medium hover:bg-blue-100 hover:text-blue-700 transition-colors bg-blue-600 text-white"
            >
              Todas las Categorías
              <span class="float-right text-xs bg-white/20 px-1.5 py-0.5 rounded">
                {allPosts.length}
              </span>
            </a>
          </li>
          
          <!-- Categorías principales con subcategorías -->
          {Object.entries(categoriesHierarchy).map(([mainCat, subCats]) => (
            <li class="mt-3">
              <div 
                class="main-category-container px-3 py-2 rounded-md text-sm font-medium text-gray-700 transition-all duration-300"
                data-subcategories={JSON.stringify(subCats)}
              >
                <span class="font-semibold">{mainCat}</span>
              </div>
              
              <ul class="ml-4 mt-1 space-y-1">
                {subCats.map(subCat => (
                  <li>
                    <a 
                      href={`/blog/?categoria=${encodeURIComponent(subCat)}`}
                      class="category-link block px-3 py-1.5 rounded-md text-sm font-medium hover:bg-blue-100 hover:text-blue-700 transition-colors text-gray-700"
                      data-category={subCat}
                    >
                      {subCat}
                      <span class="float-right text-xs bg-white/20 px-1.5 py-0.5 rounded">
                        {categoryCounts[subCat] || 0}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </aside>

      <!-- Listado de Posts -->
      <main class="w-full md:w-3/4 lg:w-4/5">
        <header class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900">Nuestro Blog</h1>
          <p id="blog-header-text" class="text-lg text-gray-600 mt-2">
            Noticias, consejos y actualizaciones de ESVA.
          </p>
        </header>

        {allPosts.length === 0 ? (
          <p class="text-center text-gray-600 text-xl py-10">
            Aún no hay publicaciones en el blog. ¡Vuelve pronto!
          </p>
        ) : (
          <>
            <!-- Barra de Búsqueda Sensitiva -->
            <div class="mb-8 max-w-xl mx-auto">
              <div class="relative group">
                <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                  <svg class="w-5 h-5 text-gray-400 group-focus-within:text-blue-500 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </span>
                <input 
                  type="text" 
                  id="search-input" 
                  placeholder="Buscar por título, descripción o etiqueta..." 
                  class="w-full pl-11 pr-11 py-3.5 bg-white border border-gray-200 rounded-2xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 text-sm transition-all duration-300 placeholder-gray-400 text-gray-800"
                />
                <button 
                  id="clear-search" 
                  type="button" 
                  class="absolute inset-y-0 right-0 flex items-center pr-4 text-gray-400 hover:text-gray-600 transition-colors hidden"
                  aria-label="Limpiar búsqueda"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div id="posts-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-8">
              {postsWithMainCategory.map(post => (
                <article 
                  class="post-card bg-white rounded-xl shadow-lg overflow-hidden flex flex-col transition-all duration-300 hover:shadow-2xl hover:-translate-y-1 opacity-100 scale-100"
                  data-tags={JSON.stringify(post.data.tags || [])}
                  data-title={post.data.title}
                  data-description={post.data.description || ''}
                >
                  {post.data.image?.url && (
                    <a href={`/blog/${post.slug}/`} class="block aspect-video overflow-hidden group">
                      <img
                        src={typeof post.data.image.url === 'string' ? post.data.image.url : post.data.image.url}
                        alt={post.data.image.alt || post.data.title}
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                      />
                    </a>
                  )}
                  <div class="p-6 flex flex-col flex-grow">
                    <h2 class="text-xl font-semibold mb-3 text-gray-800">
                      <a href={`/blog/${post.slug}/`} class="hover:text-blue-600 transition duration-300">
                        {post.data.title}
                      </a>
                    </h2>
                    {post.data.description && (
                      <p class="text-gray-600 text-sm mb-4 flex-grow">{post.data.description}</p>
                    )}
                    
                    <!-- Mostrar categoría principal -->
                    {post.mainCategory && (
                      <div class="mb-3">
                        <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded">
                          {post.mainCategory}
                        </span>
                      </div>
                    )}
                    
                    <p class="text-xs text-gray-500 mb-4">
                      {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </p>
                    <div class="mt-auto pt-2">
                      <a href={`/blog/${post.slug}/`} class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition duration-300">
                        Leer más <span aria-hidden="true" class="ml-1">&rarr;</span>
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
            
            <div id="no-posts-message" class="text-center py-16 px-4 bg-gray-50/50 rounded-2xl border border-dashed border-gray-200 hidden">
              <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">No se encontraron artículos</h3>
              <p class="text-gray-600 max-w-md mx-auto text-sm" id="no-posts-text">
                No pudimos encontrar publicaciones que coincidan con tu búsqueda.
              </p>
              <button 
                id="reset-filters" 
                class="mt-5 inline-flex items-center px-4 py-2 text-sm font-medium rounded-xl shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20 active:scale-95"
              >
                Restablecer filtros
              </button>
            </div>
          </>
        )}
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  /* Personalización de la barra de desplazamiento del menú lateral */
  aside {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }
  aside::-webkit-scrollbar {
    width: 6px;
  }
  aside::-webkit-scrollbar-track {
    background: transparent;
  }
  aside::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 3px;
  }
  aside::-webkit-scrollbar-thumb:hover {
    background-color: #94a3b8;
  }

  /* Animación premium de filtrado */
  .post-card {
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<script>
  function initFilter() {
    const postsGrid = document.getElementById('posts-grid');
    const noPostsMessage = document.getElementById('no-posts-message');
    const blogHeaderParent = document.getElementById('blog-header-text');
    const categoryLinks = document.querySelectorAll('.category-link');
    const mainCategoryContainers = document.querySelectorAll('.main-category-container');
    const postCards = document.querySelectorAll('.post-card');
    
    // Inputs del Buscador
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search');
    const resetFiltersBtn = document.getElementById('reset-filters');

    const getCategoryFromUrl = () => {
      const urlParams = new URLSearchParams(window.location.search);
      return urlParams.get('categoria');
    };

    // Estado interno
    let currentCategory = getCategoryFromUrl();
    let searchQuery = '';

    // Normalizar cadenas para búsquedas en español (quitar acentos, diacríticos y pasar a minúsculas)
    function normalizeString(str: string): string {
      return str
        ? str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim()
        : "";
    }

    function applyFilters() {
      let visibleCount = 0;
      const normalizedCategory = currentCategory ? currentCategory.toLowerCase().trim() : null;
      const normalizedSearch = normalizeString(searchQuery);
      const searchTerms = normalizedSearch.split(/\s+/).filter(Boolean);

      // Mostrar/ocultar botón de limpiar búsqueda
      if (clearSearchBtn) {
        if (searchQuery.length > 0) {
          clearSearchBtn.classList.remove('hidden');
        } else {
          clearSearchBtn.classList.add('hidden');
        }
      }

      postCards.forEach(card => {
        // 1. Filtrado por Categoría
        let tags = [];
        try {
          tags = JSON.parse(card.getAttribute('data-tags') || '[]');
        } catch(e) {
          tags = [];
        }
        const matchesCategory = !normalizedCategory || tags.some(tag => tag.toLowerCase().trim() === normalizedCategory);

        // 2. Filtrado por Búsqueda (título, descripción, tags)
        let matchesSearch = true;
        if (searchTerms.length > 0) {
          const title = normalizeString(card.getAttribute('data-title') || '');
          const description = normalizeString(card.getAttribute('data-description') || '');
          const normalizedTags = tags.map(tag => normalizeString(tag));

          matchesSearch = searchTerms.every(term => 
            title.includes(term) || 
            description.includes(term) || 
            normalizedTags.some(tag => tag.includes(term))
          );
        }

        const matches = matchesCategory && matchesSearch;

        if (matches) {
          (card as HTMLElement).style.display = 'flex';
          setTimeout(() => {
            card.classList.remove('opacity-0', 'scale-95');
            card.classList.add('opacity-100', 'scale-100');
          }, 10);
          visibleCount++;
        } else {
          card.classList.remove('opacity-100', 'scale-100');
          card.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            if (card.classList.contains('opacity-0')) {
              (card as HTMLElement).style.display = 'none';
            }
          }, 350);
        }
      });

      // Actualizar contenedor / mensaje vacío
      if (visibleCount === 0) {
        if (postsGrid) postsGrid.style.display = 'none';
        if (noPostsMessage) {
          noPostsMessage.classList.remove('hidden');
          noPostsMessage.classList.add('block');
          
          const textEl = document.getElementById('no-posts-text');
          if (textEl) {
            if (searchQuery && currentCategory) {
              textEl.textContent = `No se encontraron artículos que coincidan con "${searchQuery}" en la categoría "${currentCategory}".`;
            } else if (searchQuery) {
              textEl.textContent = `No se encontraron artículos que coincidan con "${searchQuery}".`;
            } else {
              textEl.textContent = `No hay publicaciones en la categoría "${currentCategory}".`;
            }
          }
        }
      } else {
        if (postsGrid) postsGrid.style.display = 'grid';
        if (noPostsMessage) {
          noPostsMessage.classList.remove('block');
          noPostsMessage.classList.add('hidden');
        }
      }

      // Actualizar descripción del encabezado
      if (blogHeaderParent) {
        if (currentCategory && searchQuery) {
          blogHeaderParent.textContent = `Mostrando resultados para "${searchQuery}" en la categoría "${currentCategory}".`;
        } else if (currentCategory) {
          blogHeaderParent.textContent = `Mostrando artículos de la categoría: ${currentCategory}`;
        } else if (searchQuery) {
          blogHeaderParent.textContent = `Mostrando resultados para "${searchQuery}".`;
        } else {
          blogHeaderParent.textContent = "Noticias, consejos y actualizaciones de ESVA.";
        }
      }

      // Actualizar estilos activos de los enlaces laterales
      categoryLinks.forEach(link => {
        const catAttr = link.getAttribute('data-category');
        if (!currentCategory && !catAttr) {
          link.classList.add('bg-blue-600', 'text-white');
          link.classList.remove('text-gray-700', 'hover:bg-blue-100', 'hover:text-blue-700');
        } else if (currentCategory && catAttr && catAttr.toLowerCase().trim() === normalizedCategory) {
          link.classList.add('bg-blue-600', 'text-white');
          link.classList.remove('text-gray-700', 'hover:bg-blue-100', 'hover:text-blue-700');
        } else {
          link.classList.remove('bg-blue-600', 'text-white');
          link.classList.add('text-gray-700', 'hover:bg-blue-100', 'hover:text-blue-700');
        }
      });

      // Actualizar estilos activos de categorías principales
      mainCategoryContainers.forEach(container => {
        let subcategories = [];
        try {
          subcategories = JSON.parse(container.getAttribute('data-subcategories') || '[]');
        } catch(e) {
          subcategories = [];
        }
        const isChildSelected = normalizedCategory && subcategories.some(sub => sub.toLowerCase().trim() === normalizedCategory);
        if (isChildSelected) {
          container.classList.add('bg-blue-50', 'text-blue-800', 'border-l-4', 'border-blue-500');
          container.classList.remove('text-gray-700');
        } else {
          container.classList.remove('bg-blue-50', 'text-blue-800', 'border-l-4', 'border-blue-500');
          container.classList.add('text-gray-700');
        }
      });
    }

    // Aplicar filtros iniciales
    applyFilters();

    // Eventos de teclado en la barra de búsqueda
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        applyFilters();
      });
    }

    // Botón de limpiar búsqueda
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          applyFilters();
          searchInput.focus();
        }
      });
    }

    // Botón de restablecer filtros en estado vacío
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentCategory = null;
        window.history.pushState({}, '', '/blog/');
        applyFilters();
      });
    }

    // Interceptar clics en categorías del menú lateral
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('.category-link');
      if (link) {
        e.preventDefault();
        const href = link.getAttribute('href');
        if (href) {
          const url = new URL(href, window.location.origin);
          currentCategory = url.searchParams.get('categoria');
          
          window.history.pushState({}, '', href);
          applyFilters();
        }
      }
    });

    // Escuchar el botón de atrás/adelante del navegador
    window.addEventListener('popstate', () => {
      currentCategory = getCategoryFromUrl();
      applyFilters();
    });
  }

  // Inicializar filtro en la carga de la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilter);
  } else {
    initFilter();
  }
</script>