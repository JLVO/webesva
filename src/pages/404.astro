---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import LogoEsva from "../assets/LogoEsva.svg";
---

<BaseLayout
  pageTitle="404: No encontrado"
  metaDescription="Página no encontrada. Parece que te has perdido."
>
  <main class="flex flex-col items-center justify-center h-screen text-center">
    <div class="mb-8">
      <a href="/">
        <Image src={LogoEsva} alt="Logo de ESVA" width="200" />
      </a>
    </div>
    <h1 class="text-6xl font-bold text-gray-800 dark:text-white">404</h1>
    <h2 class="text-2xl font-semibold text-gray-600 dark:text-gray-300 mb-4">
      Página No Encontrada
    </h2>
    <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-md">
      Lo sentimos, pero la página que buscas no existe o ha sido movida.
    </p>
    <a
      href="/"
      class="px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
    >
      Volver al Inicio
    </a>
  </main>
</BaseLayout>
