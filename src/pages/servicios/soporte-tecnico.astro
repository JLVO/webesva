import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import { getCollection, type CollectionEntry } from 'astro:content';
import "../../styles/global.css";
import LlamadaAction from "../../components/LlamadaAction.astro";
import PreguntasFrecuentes from '../../components/PreguntasFrecuentes.astro';

// Lógica para obtener los posts del blog
const MAX_RECENT_POSTS = 3;
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, MAX_RECENT_POSTS);

const preguntasSoporte = [
  {
    titulo: '¿Qué tipo de problemas técnicos solucionan?',
    respuesta:
      'Solucionamos una amplia gama de problemas: desde computadoras lentas, virus y fallas de software hasta problemas de hardware, configuración de redes, impresoras y periféricos. Si tienes un problema tecnológico, es muy probable que podamos ayudarte.',
  },
  {
    titulo: '¿Ofrecen soporte técnico a domicilio?',
    respuesta:
      'Sí, ofrecemos soporte técnico tanto remoto como a domicilio en Piura. Para muchos problemas, podemos conectarnos a tu equipo de forma segura y solucionarlos al instante. Si se requiere una intervención física, uno de nuestros técnicos te visitará.',
  },
  {
    titulo: 'Mi computadora no enciende, ¿pueden ayudarme?',
    respuesta:
      '¡Claro! Este es un problema común. Realizamos un diagnóstico completo para identificar la causa, que puede ser desde una fuente de poder defectuosa hasta un problema en la placa base. Te ofreceremos la mejor y más económica solución.',
  },
  {
    titulo: '¿Cuánto cuesta el servicio de soporte técnico?',
    respuesta:
      'Nuestros precios son competitivos y transparentes. El costo varía según la complejidad del problema. Ofrecemos un diagnóstico inicial para darte un presupuesto claro antes de comenzar cualquier trabajo. Contáctanos para una cotización sin compromiso.',
  },
];
---

<BaseLayout pageTitle="Soporte Técnico para PC y Laptops en Piura | ESVA" metaDescription="Soluciones rápidas y efectivas para tus problemas informáticos. Ofrecemos soporte técnico remoto y a domicilio para empresas y hogares en Piura." canonicalUrl={Astro.url.href} ogType="website">
<Hero  
  title="Soporte Técnico Informático" 
  subtitle="Soluciones rápidas y confiables para todos tus problemas tecnológicos. Devolvemos la velocidad y eficiencia a tus equipos." 
  imageUrl="/imagenes/blog/tecnico-esva-soporte-cliente.jpg" 
  buttonText="Obtener Soporte Ahora" 
  buttonLink="Escríbenos por WhatsApp"
  linkwhatsapp="https://wa.me/51985834886?text=Hola,%20necesito%20soporte%20técnico%20para%20mi%20computadora." 
  imageMaxWidth="max-w-xl" sectionPadding="py-16 md:py-20"
/>


<section class="bg-white py-16 px-6 md:px-20 text-center">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">¿Tu Tecnología te da Dolores de Cabeza?</h2>
    <p class="text-lg text-gray-700">
      Una computadora lenta, un virus o una red que falla pueden detener tu productividad y causar frustración. En ESVA, nuestro equipo de expertos está listo para diagnosticar y resolver tus problemas informáticos con <strong class="text-blue-700">rapidez y eficacia</strong>, para que puedas volver a trabajar sin interrupciones.
    </p>
  </div>
</section>


<section class="bg-blue-50 py-16 px-6 md:px-20">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-12">Nuestros Servicios de Soporte Técnico</h2>
    <div class="grid gap-8 md:grid-cols-3">
      <!-- Tarjeta 1 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Diagnóstico y Reparación de PC/Laptops</h3>
        <p class="text-gray-600">Solucionamos problemas de hardware y software, desde fallas de arranque hasta reemplazo de componentes y optimización del sistema.</p>
      </div>

      <!-- Tarjeta 2 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Eliminación de Virus y Malware</h3>
        <p class="text-gray-600">Limpiamos tu equipo de virus, spyware y otro software malicioso que compromete tu seguridad y ralentiza tu sistema.</p>
      </div>

      <!-- Tarjeta 3 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071a10 10 0 0114.142 0M1.394 9.393a15 15 0 0121.212 0"></path></svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Soporte Remoto Inmediato</h3>
        <p class="text-gray-600">Solucionamos la mayoría de los problemas de software de forma remota, segura y rápida, sin que tengas que moverte de tu sitio.</p>
      </div>
    </div>
  </div>
</section>

<LlamadaAction  
  title="¿Necesitas ayuda urgente con tu equipo?"  
  subtitle="No dejes que un problema técnico detenga tu día. Contáctanos y obtén un diagnóstico rápido y una solución efectiva de nuestros expertos."  
  buttonTextContato="Contáctanos"  
  buttonLinkLlamada="Llámanos Ahora"  
  linkwhatsapp="https://wa.me/51985834886?text=Hola,%20necesito%20soporte%20técnico%20urgente."  
  textobotonwhatsapp="WhatsApp"
/>

<section class="bg-white py-20 px-6 md:px-20">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-12">¿Por Qué Confiar tu Soporte Técnico a ESVA?</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 text-left">
      
      <!-- Beneficio 1 -->
      <div class="bg-gray-50 p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Respuesta Rápida</h3>
        <p class="text-gray-700">Entendemos la urgencia. Ofrecemos asistencia remota inmediata y programamos visitas a domicilio a la brevedad posible.</p>
      </div>

      <!-- Beneficio 2 -->
      <div class="bg-gray-50 p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Técnicos Certificados</h3>
        <p class="text-gray-700">Nuestro equipo está calificado y en constante capacitación para resolver desde los problemas más simples hasta los más complejos.</p>
      </div>

      <!-- Beneficio 3 -->
      <div class="bg-gray-50 p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Soluciones a Largo Plazo</h3>
        <p class="text-gray-700">No solo reparamos el problema actual, sino que también te asesoramos para prevenir futuras fallas y optimizar el rendimiento de tus equipos.</p>
      </div>

      <!-- Beneficio 4 -->
      <div class="bg-gray-50 p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-800 mb-2">Atención Personalizada</h3>
        <p class="text-gray-700">Escuchamos atentamente tu problema para ofrecerte una solución a medida, explicando cada paso del proceso de forma clara.</p>
      </div>

      <!-- Beneficio 5 -->
      <div class="bg-gray-50 p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Garantía de Servicio</h3>
        <p class="text-gray-700">Respaldamos nuestro trabajo. Si el problema persiste, lo solucionaremos sin costo adicional. Tu satisfacción es nuestra prioridad.</p>
      </div>

      <!-- Beneficio 6 -->
      <div class="bg-gray-50 p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Precios Justos y Transparentes</h3>
        <p class="text-gray-700">Te ofrecemos un presupuesto detallado antes de iniciar cualquier reparación. Sin costos ocultos ni sorpresas.</p>
      </div>

    </div>
  </div>
</section>

<!-- Sección del Blog -->
{recentPosts.length > 0 && (
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">
        Consejos en Nuestro Blog
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map(post => (
          <article class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
            {post.data.image?.url && (
              <a href={`/blog/${post.slug}/`} class="block aspect-video overflow-hidden group">
                <img 
                  src={typeof post.data.image.url === 'string' ? post.data.image.url : post.data.image.url} 
                  alt={post.data.image.alt || post.data.title} 
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" 
                  loading="lazy" 
                />
              </a>
            )}
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl font-semibold mb-3 text-gray-800">
                <a href={`/blog/${post.slug}/`} class="hover:text-blue-600 transition duration-300">
                  {post.data.title}
                </a>
              </h3>
              {post.data.description && (
                <p class="text-gray-600 text-sm mb-4 flex-grow">{post.data.description.slice(0, 100) + (post.data.description.length > 100 ? '...' : '')}</p>
              )}
              <p class="text-xs text-gray-500 mb-4">
                {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <div class="mt-auto pt-2">
                <a href={`/blog/${post.slug}/`} class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition duration-300">
                  Leer más <span aria-hidden="true" class="ml-1">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
      {allPosts.length > MAX_RECENT_POSTS && (
        <div class="text-center mt-12">
          <a href="/blog" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-full shadow-lg text-lg font-semibold hover:bg-blue-700 transition duration-300">
            Ver todos los posts
          </a>
        </div>
      )}
    </div>
  </section>
)}

<PreguntasFrecuentes preguntas={preguntasSoporte} />

</BaseLayout>
