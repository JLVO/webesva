---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { getCollection } from 'astro:content';
import "../../styles/global.css";
import LlamadaAction from "../../components/LlamadaAction.astro";
import PreguntasFrecuentes from '../../components/PreguntasFrecuentes.astro';

const MAX_RECENT_POSTS = 3;
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, MAX_RECENT_POSTS);

const preguntasSoporte = [
  {
    titulo: '¿Por qué contratar un plan mensual en lugar de un técnico por visita?',
    respuesta: 'Un plan mensual garantiza prevención. Mientras un técnico independiente cobra por reparar cuando algo ya falló, ESVA trabaja para que tu empresa nunca se detenga, ahorrándote costos por inactividad y pérdida de datos.',
  },
  {
    titulo: '¿Tienen cobertura presencial en Piura y Castilla?',
    respuesta: 'Sí, contamos con técnicos locales en Piura para visitas presenciales fijas y atención de emergencias. También ofrecemos soporte remoto inmediato para todo el Perú.',
  },
  {
    titulo: '¿Los planes incluyen mantenimiento de cámaras y biométricos?',
    respuesta: '¡Sí! A partir del Plan Business, integramos la gestión de tus sistemas de seguridad (CCTV y ZKTeco) dentro del mismo contrato de soporte IT.',
  },
  {
    titulo: '¿Cómo garantizan la seguridad de nuestra información?',
    respuesta: 'Como empresa formal (ESVA), firmamos acuerdos de confidencialidad y aplicamos protocolos de seguridad en cada intervención, algo que un técnico informal no suele ofrecer.',
  },
];

const whatsappTextHero = 'Hola ESVA, necesito información sobre el soporte técnico para mi empresa.';
const whatsappLinkHero = `https://wa.me/51985834886?text=${encodeURIComponent(whatsappTextHero)}`;
---

<BaseLayout 
  pageTitle="Soporte Técnico para Empresas en Piura | Planes Mensuales ESVA" 
  metaDescription="Terceriza tu soporte técnico IT en Piura. Planes mensuales desde S/ 550 para empresas. Mantenimiento preventivo, redes, cámaras y biométricos con garantía." 
  canonicalUrl={Astro.url.href} 
  ogType="website" 
  mainPadding={false}
>
  <ServiceSchema
    name="Soporte Técnico para Empresas"
    description="Terceriza tu soporte técnico IT en Piura. Planes mensuales desde S/ 550 para empresas. Mantenimiento preventivo, redes, cámaras y biométricos con garantía."
    url="https://esva.pe/servicios/soporte-tecnico/"
  />
  <BreadcrumbSchema items={[
    { name: "Inicio", url: "https://esva.pe/" },
    { name: "Servicios", url: "https://esva.pe/servicios/" },
    { name: "Soporte Técnico Empresas", url: "https://esva.pe/servicios/soporte-tecnico/" }
  ]} />

<Hero  
  title="Outsourcing de Soporte Técnico en Piura" 
  subtitle="Evita paradas innecesarias y optimiza tu inversión tecnológica. Planes mensuales de gestión IT diseñados para Pymes que buscan crecer sin fallas técnicas." 
  imageUrl="/imagenes/blog/tecnico-esva-soporte-cliente.jpg" 
  buttonText="Ver Planes para Empresas" 
  buttonLink="Ver Planes para Empresas"
  linkwhatsapp="https://wa.me/51985834886?text=Hola%20ESVA%2C%20solicito%20informaci%C3%B3n%20sobre%20los%20planes%20de%20soporte%20t%C3%A9cnico%20mensual%20para%20mi%20empresa.%20Me%20gustar%C3%ADa%20conocer los detalles de los servicios y precios."
  imageMaxWidth="max-w-xl" 
  sectionPadding="py-16 md:py-20"
/>

<section class="bg-white py-16 px-6 md:px-20 text-center border-b border-gray-100">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">¿Tu empresa se detiene por problemas informáticos?</h2>
    <p class="text-lg text-gray-700 leading-relaxed">
  Una red lenta o una computadora malograda no es solo una molestia, es <strong class="text-blue-800">dinero perdido</strong>. En ESVA, no solo reparamos equipos; nos convertimos en tu <strong class="text-blue-800">departamento de TI externo</strong> para que tú te enfoques en vender mientras nosotros aseguramos tu infraestructura.
</p>
  </div>
</section>

<section id="planes-soporte" class="py-20 bg-[#f9f9f9]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-blue-800 mb-4">Planes de Soporte Técnico Mensual</h2>
      <p class="text-lg text-gray-700 max-w-3xl mx-auto">Soluciones de tercerización con contratos flexibles (mínimo 3 meses) y facturación electrónica vía Nubefact.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      <div class="bg-white rounded-xl shadow-lg p-6 flex flex-col justify-between border border-gray-200 hover:shadow-xl transition-all">
        <div>
          <h3 class="text-2xl font-bold text-blue-700 mb-2">Soporte Inicial</h3>
          <p class="text-gray-600 mb-4 text-sm">Ideal para oficinas pequeñas o estudios contables.</p>
          <p class="text-2xl font-bold text-gray-900">S/ 550 <span class="text-sm font-normal text-gray-500">/ mes + IGV</span></p>
          <ul class="space-y-3 text-gray-700 mt-8 mb-8">
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Hasta 8 computadoras / laptops</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Soporte técnico remoto ilimitado.</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> 1 Visita preventiva presencial al mes.</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Tiempo de respuesta: &lt; 4 horas.</li>
          </ul>
        </div>
        <a href="https://wa.me/51985834886?text=Hola%20ESVA%2C%20me%20interesa%20el%20Plan%20Inicial%20para%20mi%20oficina." target="_blank" class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg transition">Cotizar Plan Inicial</a>
      </div>

      <div class="bg-white rounded-xl shadow-2xl p-6 flex flex-col justify-between border-2 border-orange-500 relative transform lg:scale-105">
        <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-orange-500 text-white text-xs font-bold px-4 py-1 rounded-full uppercase">Más Popular</span>
        <div>
          <h3 class="text-2xl font-bold text-blue-700 mb-2">Gestión Business</h3>
          <p class="text-gray-600 mb-4 text-sm">La solución completa para Pymes en crecimiento.</p>
          <p class="text-2xl font-bold text-gray-900">S/ 1,550 <span class="text-sm font-normal text-gray-500">/ mes + IGV</span></p>
          <ul class="space-y-3 text-gray-700 mt-8 mb-8">
            <li class="flex items-start font-semibold"><span class="text-green-500 mr-2">✔</span> Hasta 20 computadoras / laptops.</li>
            <li class="flex items-start">
  <span class="text-green-500 mr-2">✔</span> 
  <strong>1 Visita fija semanal (4 al mes).</strong>
</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Gestión de Cámaras y Biométricos.</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Atención prioritaria de emergencias.</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Tiempo de respuesta: &lt; 2 horas.</li>
          </ul>
        </div>
        <a href="https://wa.me/51985834886?text=Hola%20ESVA%2C%20v%C3%AD%20el%20Plan%20Gesti%C3%B3n%20Business%20en%20la%20web%20y%20quiero%20contratarlo." target="_blank" class="block w-full text-center bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-lg shadow-lg transition">Contratar Ahora</a>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 flex flex-col justify-between border border-gray-200 hover:shadow-xl transition-all">
        <div>
          <h3 class="text-2xl font-bold text-blue-700 mb-2">Solución Enterprise</h3>
          <p class="text-gray-600 mb-4 text-sm">Outsourcing IT total para alta demanda.</p>
          <p class="text-2xl font-bold text-gray-900 mb-6">Precio a medida</p>
          <ul class="space-y-3 text-gray-700 mb-8">
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Hasta 40 computadoras + Servidores.</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> 2 Visitas fijas semanales + Emergencias.</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Gestión de Backups y Ciberseguridad.</li>
            <li class="flex items-start"><span class="text-green-500 mr-2">✔</span> Soporte prioritario 24/7 Críticos.</li>
          </ul>
        </div>
        <a href="https://wa.me/51985834886?text=Hola%20ESVA%2C%20requiero%20una%20consultor%C3%ADa%20para%20el%20Plan%20Enterprise." target="_blank" class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg transition">Solicitar Consultoría</a>
      </div>
    </div>
  </div>
</section>

<section class="bg-white py-20 px-6 md:px-20">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-blue-900 mb-12 text-center">¿Por qué las empresas en Piura eligen a ESVA?</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="p-6 border-l-4 border-blue-600 bg-gray-50">
        <h3 class="font-bold text-lg mb-2">Facturación y Formalidad</h3>
        <p class="text-gray-600 text-sm">
  Somos empresa constituida (<strong>RUC 20</strong>). Entregamos factura electrónica para que deduzcas tus impuestos sin problemas.
</p>
      </div>
      <div class="p-6 border-l-4 border-blue-600 bg-gray-50">
        <h3 class="font-bold text-lg mb-2">Prevención Garantizada</h3>
        <p class="text-gray-600 text-sm">No somos "bomberos". Nuestro enfoque es preventivo para que las fallas no ocurran y tu personal siempre sea productivo.</p>
      </div>
      <div class="p-6 border-l-4 border-blue-600 bg-gray-50">
        <h3 class="font-bold text-lg mb-2">Experiencia Multimarca</h3>
        <p class="text-gray-600 text-sm">Expertos en Dahua, Hikvision y ZKTeco. Gestionamos tu red, tus cámaras y tus biometría en un solo lugar.</p>
      </div>
    </div>
  </div>
</section>

<LlamadaAction  
  title="¿Tu soporte actual no te da garantías?"  
  subtitle="Cámbiate a ESVA. Realizamos una auditoría gratuita de tus equipos al contratar cualquier plan mensual por 6 meses."  
  buttonTextContato="Cotizar ahora"  
  buttonLinkLlamada="Llámanos"  
  linkwhatsapp="https://wa.me/51985834886?text=Hola%20ESVA%2C%20quiero%20la%20auditor%C3%ADa%20gratuita%20de%20mis%20equipos."  
  textobotonwhatsapp="WhatsApp"
/>

<PreguntasFrecuentes preguntas={preguntasSoporte} />

</BaseLayout>