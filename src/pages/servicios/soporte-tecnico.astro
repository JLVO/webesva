---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { getCollection } from 'astro:content';
import "../../styles/global.css";
import LlamadaAction from "../../components/LlamadaAction.astro";
import PreguntasFrecuentes from '../../components/PreguntasFrecuentes.astro';

const MAX_RECENT_POSTS = 3;
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, MAX_RECENT_POSTS);

const preguntasSoporte = [
  {
    titulo: '¿Por qué contratar un plan mensual en lugar de un técnico por visita?',
    respuesta: 'Un plan mensual garantiza prevención. Mientras un técnico independiente cobra por reparar cuando algo ya falló, ESVA trabaja para que tu empresa nunca se detenga, ahorrándote costos por inactividad y pérdida de datos.',
  },
  {
    titulo: '¿Tienen cobertura presencial en Piura y Castilla?',
    respuesta: 'Sí, contamos con técnicos locales en Piura para visitas presenciales fijas y atención de emergencias. También ofrecemos soporte remoto inmediato para todo el Perú.',
  },
  {
    titulo: '¿Los planes incluyen mantenimiento de cámaras y biométricos?',
    respuesta: '¡Sí! A partir del Plan Profesional, integramos la gestión de tus sistemas de seguridad (CCTV y ZKTeco) dentro del mismo contrato de soporte IT.',
  },
  {
    titulo: '¿Cómo garantizan la seguridad de nuestra información?',
    respuesta: 'Como empresa formal (ESVA), firmamos acuerdos de confidencialidad y aplicamos protocolos de seguridad en cada intervención, algo que un técnico informal no suele ofrecer.',
  },
];

const whatsappTextHero = 'Hola ESVA, necesito información sobre el soporte técnico para mi empresa.';
const whatsappLinkHero = `https://wa.me/51935173103?text=${encodeURIComponent(whatsappTextHero)}`;
---

<BaseLayout 
  pageTitle="Soporte Técnico para Empresas en Piura | Planes Mensuales ESVA" 
  metaDescription="Terceriza tu soporte técnico IT en Piura. Planes mensuales desde S/ 790 para empresas. Mantenimiento preventivo, redes, cámaras y biométricos con garantía."
  canonicalUrl={Astro.url.href} 
  ogType="website" 
  mainPadding={false}
>
  <ServiceSchema
    name="Soporte Técnico para Empresas"
    description="Terceriza tu soporte técnico IT en Piura. Planes mensuales desde S/ 790 para empresas. Mantenimiento preventivo, redes, cámaras y biométricos con garantía."
    url="https://esva.pe/servicios/soporte-tecnico/"
  />
  <BreadcrumbSchema items={[
    { name: "Inicio", url: "https://esva.pe/" },
    { name: "Servicios", url: "https://esva.pe/servicios/" },
    { name: "Soporte Técnico Empresas", url: "https://esva.pe/servicios/soporte-tecnico/" }
  ]} />

<Hero  
  title="Outsourcing de Soporte Técnico en Piura" 
  subtitle="Evita paradas innecesarias y optimiza tu inversión tecnológica. Planes mensuales de gestión IT diseñados para Pymes que buscan crecer sin fallas técnicas." 
  imageUrl="/imagenes/blog/tecnico-esva-soporte-cliente.webp" 
  buttonText="Ver Planes para Empresas" 
  buttonLink="Ver Planes para Empresas"
  linkwhatsapp="https://wa.me/51935173103?text=Hola%20ESVA%2C%20solicito%20informaci%C3%B3n%20sobre%20los%20planes%20de%20soporte%20t%C3%A9cnico%20mensual%20para%20mi%20empresa.%20Me%20gustar%C3%ADa%20conocer los detalles de los servicios y precios."
  imageMaxWidth="max-w-xl" 
  sectionPadding="py-16 md:py-20"
/>

<section class="bg-white py-16 px-6 md:px-20 text-center border-b border-gray-100">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">¿Tu empresa se detiene por problemas informáticos?</h2>
    <p class="text-lg text-gray-700 leading-relaxed">
  Una red lenta o una computadora malograda no es solo una molestia, es <strong class="text-blue-800">dinero perdido</strong>. En ESVA, no solo reparamos equipos; nos convertimos en tu <strong class="text-blue-800">departamento de TI externo</strong> para que tú te enfoques en vender mientras nosotros aseguramos tu infraestructura.
</p>
  </div>
</section>

<section id="planes-soporte" class="py-20 bg-[#f9f9f9]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-blue-800 mb-4">Planes de Soporte Técnico Mensual para Empresas en Piura</h2>
      <p class="text-lg text-gray-700 max-w-3xl mx-auto">Asegura la continuidad de tu negocio. En ESVA tercerizamos tu departamento de TI para que tu infraestructura tecnológica sea una ventaja, no un problema.</p>
    </div>

    <div class="flex flex-wrap justify-center gap-3 mb-4" role="group" aria-label="Frecuencia de facturación">
      <button type="button" data-billing="1" class="billing-toggle-btn active bg-gray-100 border border-gray-300 text-gray-700 px-4 py-2 rounded-full text-sm font-bold shadow-sm transition">Mensual</button>
      <button type="button" data-billing="0.95" class="billing-toggle-btn bg-blue-50 border border-blue-200 text-blue-700 px-4 py-2 rounded-full text-sm font-bold shadow-sm transition">Trimestral <span class="font-normal">-5%</span></button>
      <button type="button" data-billing="0.90" class="billing-toggle-btn bg-green-50 border border-green-200 text-green-700 px-4 py-2 rounded-full text-sm font-bold shadow-sm transition">Semestral <span class="font-normal">-10%</span></button>
      <button type="button" data-billing="0.85" class="billing-toggle-btn bg-yellow-50 border border-yellow-200 text-yellow-700 px-4 py-2 rounded-full text-sm font-bold shadow-sm transition">Anual <span class="font-normal">-15%</span></button>
    </div>
    <p class="text-center text-sm text-gray-500 mb-12">Los precios de los planes se actualizan según la frecuencia que elijas. El plan Anual además incluye 1 Mantenimiento General gratis.</p>
    <style>
      .billing-toggle-btn.active {
        outline: 3px solid #1f2937;
        outline-offset: 1px;
        font-weight: 800;
      }
    </style>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">

      <div class="bg-white rounded-xl shadow-lg p-6 flex flex-col justify-between border border-gray-200 hover:shadow-xl transition-all duration-300">
        <div>
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-blue-700">Plan Esencial</h3>
            <span class="text-xs font-semibold bg-blue-100 text-blue-600 px-2 py-1 rounded uppercase">Microempresa</span>
          </div>
          <p class="text-gray-600 mb-4">Para oficinas de 1 a 5 equipos que necesitan estabilidad inmediata.</p>

          <div class="mb-6">
            <p class="text-3xl font-bold text-gray-900"><span class="plan-price" data-base="790">S/ 790</span> <span class="text-sm font-normal text-gray-500 plan-period">/ mes</span></p>
            <p class="text-xs text-gray-400">* Precios + IGV. Sujeto a evaluación técnica.</p>
          </div>

          <ul class="space-y-3 text-gray-700 mb-8">
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> Soporte remoto ilimitado</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> 2 Visitas técnicas presenciales al mes</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> Mantenimiento preventivo</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> Gestión de incidencias (Tickets)</li>
          </ul>
        </div>
        <p class="text-gray-600 text-sm">
            ✔ Ideal para evitar fallas y mantener tu negocio operativo.
          </p>
        <a href="https://wa.me/51935173103?text=Hola%20ESVA%2C%20estoy%20interesado%20en%20el%20Plan%20Esencial%20para%20mi%20negocio.%20Tengo%20entre%201%20a%205%20equipos."
           target="_blank"
           class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-all">
           Empezar con Plan Esencial
        </a>
      </div>

      <div class="bg-white rounded-xl shadow-2xl p-6 flex flex-col justify-between border-2 border-orange-500 relative transform lg:scale-110 z-10">
        <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-orange-500 text-white text-xs font-bold px-4 py-1 rounded-full uppercase shadow-md tracking-wider">Más Elegido</span>
        <div>
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-blue-800">Plan Profesional</h3>
            <span class="text-xs font-semibold bg-orange-100 text-orange-600 px-2 py-1 rounded uppercase">PYME en Crecimiento</span>
          </div>
          <p class="text-gray-600 mb-4">Gestión completa para empresas de 6 a 15 estaciones de trabajo.</p>

          <div class="mb-6">
            <p class="text-3xl font-bold text-gray-900">Desde <span class="plan-price" data-base="1290">S/ 1290</span> <span class="text-sm font-normal text-gray-500 plan-period">/ mes</span></p>
            <p class="text-xs text-gray-400">* Precios + IGV. Escala hasta S/2100 según cantidad de equipos. Sujeto a evaluación técnica.</p>
          </div>

          <ul class="space-y-3 text-gray-700 mb-8">
            <li class="flex items-start"><i class="fas fa-check-circle text-orange-500 mt-1 mr-2"></i> Soporte remoto ilimitado (Prioridad Alta)</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-orange-500 mt-1 mr-2"></i> 4 Visitas presenciales de mantenimiento</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-orange-500 mt-1 mr-2"></i> Gestión de redes y conectividad WiFi</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-orange-500 mt-1 mr-2"></i> Inventario técnico de hardware</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-orange-500 mt-1 mr-2"></i> Reporte mensual de desempeño TI</li>
          </ul>
        </div>

         <p class="text-gray-600 text-sm">
            ✔ Previene fallas y mejora la productividad de tu equipo.
          </p>

        <a href="https://wa.me/51935173103?text=Hola%20ESVA%2C%20requiero%20el%20Plan%20Profesional.%20Necesitamos%20un%20soporte%20m%C3%A1s%20robusto%20para%20nuestros%20equipos%20y%20red."
           target="_blank"
           class="block w-full text-center bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 px-6 rounded-lg transition-all shadow-lg">
           Contratar Plan Profesional
        </a>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 flex flex-col justify-between border border-gray-200 hover:shadow-xl transition-all duration-300">
        <div>
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-blue-700">Plan Empresarial</h3>
            <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-2 py-1 rounded uppercase">Outsourcing Total</span>
          </div>
          <p class="text-gray-600 mb-4">Para empresas con más de 15 equipos e infraestructura crítica.</p>

          <div class="mb-6">
            <p class="text-3xl font-bold text-gray-900">Desde <span class="plan-price" data-base="3200">S/ 3200</span>+ <span class="text-sm font-normal text-gray-500 plan-period">/ mes</span></p>
            <p class="text-xs text-gray-400">* Precios + IGV. Escala según servidores y sistemas complejos. Sujeto a evaluación técnica.</p>
          </div>

          <ul class="space-y-3 text-gray-700 mb-8">
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> Soporte 24/7 para incidencias críticas</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> Visitas técnicas según necesidad</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> Gestión de Servidores y Backups Cloud</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> Soporte a Cámaras CCTV y Biometría</li>
            <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mt-1 mr-2"></i> Consultoría para Proyectos de Expansión</li>
          </ul>
        </div>

        <p class="text-gray-600 text-sm">
            ✔ Tu área de sistemas completa sin contratar personal interno.
          </p>

        <a href="https://wa.me/51935173103?text=Hola%20ESVA%2C%20buscamos%20un%20Outsourcing%20Total.%20Tenemos%20servidores%20y%20una%20infraestructura%20grande%20que%20gestionar."
           target="_blank"
           class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-all">
           Solicitar Auditoría TI
        </a>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm text-center">
      <p class="text-gray-700 font-medium mb-4">¿Tu empresa tiene necesidades únicas o más de 30 equipos?</p>
      <div class="flex flex-col md:flex-row justify-center items-center gap-4">
        <a href="https://wa.me/51935173103?text=Hola%20equipo%20de%20ESVA%2C%20mi%20empresa%20tiene%20necesidades%20fuera%20de%20los%20planes%20est%C3%A1ndar%20(m%C3%A1s%20de%2030%20equipos%20u%20otro%20requerimiento%20particular).%20Quisiera%20un%20presupuesto%20a%20medida." class="text-blue-600 hover:underline font-bold text-lg">
          <i class="fab fa-whatsapp"></i> Solicita un presupuesto a medida
        </a>
        <span class="hidden md:block text-gray-300">|</span>
        <p class="text-gray-500 text-sm italic">Incluimos un diagnóstico inicial preventivo sin costo al contratar cualquier plan.</p>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  function updatePrices(multiplier: number) {
    document.querySelectorAll(".plan-price").forEach(function (el) {
      const base = parseFloat(el.getAttribute("data-base") || "0");
      if (!base) return;
      const nuevo = Math.round((base * multiplier) / 10) * 10;
      el.textContent = "S/ " + nuevo;
    });
    document.querySelectorAll(".plan-period").forEach(function (el) {
      el.textContent = multiplier === 1 ? "/ mes" : "/ mes*";
    });
  }

  document.querySelectorAll(".billing-toggle-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll(".billing-toggle-btn").forEach(function (b) {
        b.classList.remove("active");
      });
      btn.classList.add("active");
      const multiplier = parseFloat(btn.getAttribute("data-billing") || "1");
      updatePrices(multiplier);
    });
  });
})();
</script>

<section class="bg-white py-20 px-6 md:px-20">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-blue-900 mb-12 text-center">¿Por qué las empresas en Piura eligen a ESVA?</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="p-6 border-l-4 border-blue-600 bg-gray-50">
        <h3 class="font-bold text-lg mb-2">Facturación y Formalidad</h3>
        <p class="text-gray-600 text-sm">
  Somos empresa constituida (<strong>RUC 20</strong>). Entregamos factura electrónica para que deduzcas tus impuestos sin problemas.
</p>
      </div>
      <div class="p-6 border-l-4 border-blue-600 bg-gray-50">
        <h3 class="font-bold text-lg mb-2">Prevención Garantizada</h3>
        <p class="text-gray-600 text-sm">No somos "bomberos". Nuestro enfoque es preventivo para que las fallas no ocurran y tu personal siempre sea productivo.</p>
      </div>
      <div class="p-6 border-l-4 border-blue-600 bg-gray-50">
        <h3 class="font-bold text-lg mb-2">Experiencia Multimarca</h3>
        <p class="text-gray-600 text-sm">Expertos en Dahua, Hikvision y ZKTeco. Gestionamos tu red, tus cámaras y tus biometría en un solo lugar.</p>
      </div>
    </div>
  </div>
</section>

<LlamadaAction  
  title="¿Tu soporte actual no te da garantías?"  
  subtitle="Cámbiate a ESVA. Realizamos una auditoría gratuita de tus equipos al contratar cualquier plan mensual por 6 meses."  
  buttonTextContato="Cotizar ahora"  
  buttonLinkLlamada="Llámanos"  
  linkwhatsapp="https://wa.me/51935173103?text=Hola%20ESVA%2C%20quiero%20la%20auditor%C3%ADa%20gratuita%20de%20mis%20equipos."  
  textobotonwhatsapp="WhatsApp"
/>

<PreguntasFrecuentes preguntas={preguntasSoporte} />

</BaseLayout>