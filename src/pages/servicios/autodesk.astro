---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import "../../styles/global.css";
import LlamadaAction from "../../components/LlamadaAction.astro";
import PreguntasFrecuentes from '../../components/PreguntasFrecuentes.astro';
import { getCollection } from 'astro:content';

// Filtramos el blog para que solo muestre lo más reciente (o artículos de software si los hay)
const MAX_RECENT_POSTS = 3;
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, MAX_RECENT_POSTS);

// Contenido especializado en Autodesk - SEO Optimized
const preguntasAutodesk = [
  {
    titulo: '¿Por qué comprar licencias de Autodesk con ESVA en lugar de la web global?',
    respuesta: 'Al comprar con ESVA, obtienes facturación local (RUC 20), soporte técnico presencial en Piura y asesoría experta para elegir el plan exacto que tu proyecto necesita, evitando cobros internacionales inesperados.',
  },
  {
    titulo: '¿Qué diferencia hay entre AutoCAD y AutoCAD LT?',
    respuesta: 'AutoCAD LT es la versión económica ideal para dibujo 2D. AutoCAD completo incluye herramientas de modelado 3D, automatización avanzada y acceso a bibliotecas especializadas de arquitectura, mecánica y electricidad.',
  },
  {
    titulo: '¿Cómo recibo mi licencia tras la compra?',
    respuesta: 'Como Resellers Autorizados, gestionamos la activación directamente en tu cuenta de Autodesk. Recibirás un correo oficial de confirmación y el acceso estará disponible de inmediato en tu portal "Autodesk Account".',
  },
  {
    titulo: '¿Es seguro comprar con ESVA?',
    respuesta: 'Totalmente. Somos Partner Autorizado vía SONDA. Entregamos certificado de licenciamiento original y factura electrónica válida ante SUNAT, garantizando que tu empresa cumpla con todas las auditorías de software.',
  },
];

const waNumber = "51935173103";
const mainWaText = 'Hola ESVA, deseo información y precios sobre licencias originales de Autodesk para mi empresa.';
const linkWhatsapp = `https://wa.me/${waNumber}?text=${encodeURIComponent(mainWaText)}`;

const productos = [
  { 
    nombre: "AutoCAD / LT", 
    desc: "El estándar de la industria para dibujo 2D y diseño 3D. Ideal para planos técnicos.",
    icon: "📐",
    wa: `https://wa.me/${waNumber}?text=Hola,%20deseo%20cotizar%20AutoCAD/LT%20con%20ESVA`
  },
  {
    nombre: "AutoCAD Revit LT Suite",
    desc: "AutoCAD más una versión LT de Revit, en una sola suscripción. Ideal para iniciarte en modelado BIM.",
    icon: "🏢",
    wa: `https://wa.me/${waNumber}?text=Hola,%20necesito%20info%20sobre%20AutoCAD%20Revit%20LT%20Suite`
  },
  {
    nombre: "3ds Max",
    desc: "Modelado, animación y renderizado 3D para proyectos de diseño, arquitectura y visualización.",
    icon: "🎬",
    wa: `https://wa.me/${waNumber}?text=Hola,%20cotización%20para%203ds%20Max%20en%20Piura`
  }
];
---

<BaseLayout 
  pageTitle="Licencias Autodesk Originales en Piura | ESVA"
  metaDescription="Distribuidor oficial de licencias AutoCAD, AutoCAD LT y AutoCAD Revit LT Suite en Piura y todo el Perú. ESVA ofrece software original, facturación local RUC 20 y soporte técnico."
  canonicalUrl={Astro.url.href}
  ogType="website"
  mainPadding={false}
>
  <ServiceSchema
    name="Licencias Autodesk (AutoCAD, AutoCAD LT, Revit LT Suite)"
    description="Distribuidor oficial de licencias AutoCAD, AutoCAD LT y AutoCAD Revit LT Suite en Piura y todo el Perú. ESVA ofrece software original, facturación local RUC 20 y soporte técnico."
    url="https://esva.pe/servicios/autodesk/"
  />
  <BreadcrumbSchema items={[
    { name: "Inicio", url: "https://esva.pe/" },
    { name: "Servicios", url: "https://esva.pe/servicios/" },
    { name: "Partner Autodesk", url: "https://esva.pe/servicios/autodesk/" }
  ]} />

  <Hero  
    title="Partner Autorizado Autodesk en Piura y todo el Perú" 
    subtitle="Adquiere software original con facturación local y soporte técnico especializado. Potencia tus proyectos de ingeniería con el respaldo de ESVA y SONDA." 
    imageUrl="/imagenes/blog/autodesk-reseller-peru.webp" 
    buttonText="Solicitar Cotización" 
    buttonLink="Escríbenos por WhatsApp"
    linkwhatsapp={linkWhatsapp}
    sectionPadding="py-6 md:py-10"
    
  />

  <section class="bg-white py-16 px-6 md:px-20 text-center border-b">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-blue-900 text-sm font-bold tracking-widest uppercase mb-2">Distribuidor Oficial de Software</h1>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Soluciones de Ingeniería y Arquitectura Legal</h2>
      <p class="text-lg text-gray-700 mb-8">
        En <strong>ESVA</strong>, somos tus aliados estratégicos. Como <strong>Authorized Reseller de Autodesk</strong> vía SONDA, garantizamos que tu inversión sea segura y cumpla con la normativa legal en el Perú.
      </p>
      
      <div class="flex flex-wrap justify-center gap-4">
        <span class="bg-blue-50 text-blue-700 px-5 py-2 rounded-full font-semibold border border-blue-100 shadow-sm">✔ Facturación Local (RUC 20)</span>
        <span class="bg-blue-50 text-blue-700 px-5 py-2 rounded-full font-semibold border border-blue-100 shadow-sm">✔ Soporte Técnico en Piura</span>
        <span class="bg-blue-50 text-blue-700 px-5 py-2 rounded-full font-semibold border border-blue-100 shadow-sm">✔ Activación Inmediata</span>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-blue-950">Software Autodesk Original</h2>
        <p class="text-gray-600 mt-4 text-lg">Las herramientas líderes con la mejor asesoría comercial del norte peruano.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {productos.map(prod => (
          <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all border-b-4 border-transparent hover:border-blue-600 group">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform inline-block">{prod.icon}</div>
            <h3 class="text-xl font-bold text-gray-800 mb-3">{prod.nombre}</h3>
            <p class="text-gray-600 text-sm mb-6 leading-relaxed">{prod.desc}</p>
            <a href={prod.wa} target="_blank" class="text-blue-600 font-bold text-sm flex items-center gap-2 hover:text-blue-800">
              COTIZAR AHORA <span>→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <LlamadaAction  
    title="¿Tu suscripción de Autodesk está por vencer?"  
    subtitle="Evita multas y bloqueos. Renovamos tus licencias actuales con precios preferenciales y soporte local para empresas de Piura, Trujillo y todo el Perú."
    buttonTextContato="Asesoría de Licenciamiento"  
    buttonLinkLlamada="tel:+51935173103"  
    linkwhatsapp={`https://wa.me/${waNumber}?text=Hola%20ESVA,%20necesito%20renovar%20mis%20licencias%20de%20Autodesk%20próximas%20a%20vencer.`}
    textobotonwhatsapp="Consultar por WhatsApp"
  />

  <section class="bg-white py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-blue-900 mb-6">Expertos en Transformación Digital</h2>
          <p class="text-gray-700 mb-6 text-lg">Entendemos el flujo de trabajo real de la oficina técnica. En ESVA apoyamos a:</p>
          <ul class="space-y-4">
            <li class="flex items-center gap-3 text-gray-800 font-medium italic">
              <span class="text-blue-600 font-bold">✓</span> Estudios de Arquitectura y Consultoras
            </li>
            <li class="flex items-center gap-3 text-gray-800 font-medium italic">
              <span class="text-blue-600 font-bold">✓</span> Empresas Constructoras e Inmobiliarias
            </li>
            <li class="flex items-center gap-3 text-gray-800 font-medium italic">
              <span class="text-blue-600 font-bold">✓</span> Departamentos de Ingeniería y Catastro
            </li>
            <li class="flex items-center gap-3 text-gray-800 font-medium italic">
              <span class="text-blue-600 font-bold">✓</span> Alumnos y Academias de Diseño
            </li>
          </ul>
        </div>
        <div class="bg-blue-900 p-10 rounded-3xl text-white shadow-2xl relative overflow-hidden">
          <div class="relative z-10">
            <h3 class="text-2xl font-bold mb-4">El Compromiso ESVA</h3>
            <p class="mb-6 opacity-90 text-lg leading-relaxed">
              "Como Partner Autorizado, nuestra misión es garantizar que tu empresa opere con software 100% legal, evitando riesgos técnicos y legales. Somos especialistas que entienden los flujos de ingeniería, asegurando que cada licencia sea una inversión rentable para tu negocio."
            </p>
            <div class="border-t border-blue-800 pt-6">
              <p class="font-bold text-xl">Jose Luis Vargas Ojeda</p>
              <p class="text-sm opacity-75 uppercase tracking-widest">Gerente General — ESVA</p>
            </div>
          </div>
          <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-blue-800 rounded-full opacity-20"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-blue-900">Proceso de Adquisición Simple</h2>
        <p class="text-gray-600 mt-2">Transparencia y rapidez en cada paso.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mb-6 group-hover:bg-blue-700 transition-colors shadow-lg">1</div>
          <h3 class="text-xl font-bold mb-3 text-gray-800">Cotización</h3>
          <p class="text-gray-600">Analizamos tus necesidades y te enviamos una propuesta formal con precios competitivos de Partner.</p>
        </div>
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mb-6 group-hover:bg-blue-700 transition-colors shadow-lg">2</div>
          <h3 class="text-xl font-bold mb-3 text-gray-800">Pago Local</h3>
          <p class="text-gray-600">Pagas en cuentas corporativas de ESVA en Soles o Dólares. Emitimos tu factura electrónica de inmediato.</p>
        </div>
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mb-6 group-hover:bg-blue-700 transition-colors shadow-lg">3</div>
          <h3 class="text-xl font-bold mb-3 text-gray-800">Activación</h3>
          <p class="text-gray-600">Activamos las licencias en tu portal de Autodesk. Soporte técnico incluido para la instalación inicial.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="cotizar-autodesk" class="bg-blue-950 py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-white">Solicita tu Cotización de Autodesk</h2>
        <p class="text-blue-200 mt-4 text-lg">
          Cuéntanos qué necesitas y te enviamos una propuesta personalizada. No publicamos precios de lista porque cada licencia se cotiza según tu caso (nueva vs. renovación, cantidad, plazo).
        </p>
      </div>

      <form id="autodesk-form" class="bg-white p-8 md:p-10 rounded-2xl shadow-2xl space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="ad-nombre" class="block text-sm font-medium text-gray-700 mb-2">Nombre completo *</label>
            <input type="text" id="ad-nombre" name="nombre" required
              class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="ad-empresa" class="block text-sm font-medium text-gray-700 mb-2">Empresa / RUC (opcional)</label>
            <input type="text" id="ad-empresa" name="empresa"
              class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="ad-correo" class="block text-sm font-medium text-gray-700 mb-2">Correo electrónico *</label>
            <input type="email" id="ad-correo" name="correo" required
              class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="ad-telefono" class="block text-sm font-medium text-gray-700 mb-2">Teléfono / WhatsApp *</label>
            <input type="tel" id="ad-telefono" name="telefono" required placeholder="Ej: 935 173 103"
              class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
          </div>
        </div>

        <div>
          <span class="block text-sm font-medium text-gray-700 mb-2">¿Qué tipo de solicitud es? *</span>
          <div class="flex flex-wrap gap-4">
            <label class="flex items-center gap-2 bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 cursor-pointer flex-1">
              <input type="radio" name="tipoSolicitud" value="nueva" checked class="accent-blue-600" />
              <span>Suscripción nueva</span>
            </label>
            <label class="flex items-center gap-2 bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 cursor-pointer flex-1">
              <input type="radio" name="tipoSolicitud" value="renovacion" class="accent-blue-600" />
              <span>Renovación de una que ya tengo</span>
            </label>
          </div>
        </div>

        <div id="ad-renovacion-campo" class="hidden">
          <label for="ad-userid" class="block text-sm font-medium text-gray-700 mb-2">User ID o correo de tu cuenta Autodesk (para verificar tu suscripción) *</label>
          <input type="text" id="ad-userid" name="userIdAutodesk"
            class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        </div>

        <div>
          <span class="block text-sm font-medium text-gray-700 mb-2">¿Qué producto(s) te interesan? *</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {Object.entries({
              'autocad': 'AutoCAD (incluye toolsets)',
              'autocad-lt': 'AutoCAD LT',
              'autocad-revit-lt-suite': 'AutoCAD Revit LT Suite',
              'autocad-lt-mac': 'AutoCAD LT para Mac',
              'autocad-raster-design': 'AutoCAD Raster Design',
              'autocad-web': 'AutoCAD Web',
              '3ds-max': '3ds Max',
              'mudbox': 'Mudbox',
              'flow-studio': 'Flow Studio',
              'navpack': 'NavPack (Navisworks)',
              'otro': 'Otro / no estoy seguro',
            }).map(([value, label]) => (
              <label class="flex items-center gap-2 bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 cursor-pointer text-sm">
                <input type="checkbox" name="productos" value={value} class="accent-blue-600" />
                <span>{label}</span>
              </label>
            ))}
          </div>
          <div id="ad-productos-info" class="hidden mt-3 p-4 rounded-xl bg-amber-50 border border-amber-300 text-sm text-amber-900 space-y-2"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="ad-cantidad" class="block text-sm font-medium text-gray-700 mb-2">Cantidad de licencias (opcional)</label>
            <input type="number" id="ad-cantidad" name="cantidad" min="1" placeholder="Ej: 3"
              class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="ad-plazo" class="block text-sm font-medium text-gray-700 mb-2">Plazo preferido</label>
            <select id="ad-plazo" name="plazo"
              class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
              <option value="no-se">No estoy seguro, asesórenme</option>
              <option value="anual">Anual</option>
              <option value="3-anos">3 años</option>
            </select>
          </div>
        </div>

        <div>
          <label for="ad-comentarios" class="block text-sm font-medium text-gray-700 mb-2">Comentarios adicionales (opcional)</label>
          <textarea id="ad-comentarios" name="comentarios" rows="4" placeholder="Cuéntanos más sobre tu proyecto o necesidad..."
            class="w-full p-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
        </div>

        <div id="ad-form-success" class="hidden p-4 rounded-xl bg-green-50 text-green-700 border border-green-200 text-sm font-medium">
          ¡Solicitud enviada! Te contactaremos pronto con tu cotización.
        </div>
        <div id="ad-form-error" class="hidden p-4 rounded-xl bg-red-50 text-red-700 border border-red-200 text-sm font-medium"></div>

        <button type="submit" id="ad-submit-btn"
          class="w-full bg-blue-600 text-white px-6 py-4 rounded-xl shadow hover:bg-blue-700 transition font-medium text-lg flex items-center justify-center gap-2">
          <span>Solicitar Cotización</span>
          <span id="ad-loading-spinner" class="hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
        </button>
      </form>
    </div>
  </section>

  {recentPosts.length > 0 && (
    <section class="bg-white py-20 px-6 border-t">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">Novedades y Tecnología</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {recentPosts.map(post => (
            <article class="bg-white rounded-xl shadow-sm overflow-hidden flex flex-col hover:shadow-lg transition-all border border-gray-100">
              {post.data.image?.url && (
                <a href={`/blog/${post.slug}/`} class="block aspect-video overflow-hidden">
                  <img src={post.data.image.url} alt={post.data.title} class="w-full h-full object-cover" loading="lazy" />
                </a>
              )}
              <div class="p-6">
                <h3 class="text-xl font-bold mb-2 text-gray-800 hover:text-blue-600">
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h3>
                <p class="text-xs text-gray-400 mb-4">{new Date(post.data.pubDate).toLocaleDateString('es-PE')}</p>
                <a href={`/blog/${post.slug}/`} class="text-blue-600 text-sm font-bold uppercase tracking-wider hover:underline">Leer más</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <PreguntasFrecuentes preguntas={preguntasAutodesk} />

  <script>
    const adForm = document.getElementById('autodesk-form') as HTMLFormElement | null;
    const adBtn = document.getElementById('ad-submit-btn') as HTMLButtonElement | null;
    const adSpinner = document.getElementById('ad-loading-spinner');
    const adSuccess = document.getElementById('ad-form-success');
    const adError = document.getElementById('ad-form-error');
    const adRenovacionCampo = document.getElementById('ad-renovacion-campo');
    const adUserIdInput = document.getElementById('ad-userid') as HTMLInputElement | null;
    const adProductosInfo = document.getElementById('ad-productos-info');

    // Descripción breve de cada producto, para orientar al cliente al seleccionarlo
    const descripcionesProductos: Record<string, string> = {
      'autocad': 'AutoCAD (incluye toolsets): CAD 2D/3D de uso general, con todos los toolsets especializados (arquitectura, mecánico, eléctrico, mapeo, etc.) incluidos sin costo adicional.',
      'autocad-lt': 'AutoCAD LT: versión solo 2D de AutoCAD, más económica. Ideal para dibujo técnico y planos sin necesidad de modelado 3D.',
      'autocad-revit-lt-suite': 'AutoCAD Revit LT Suite: AutoCAD más una versión LT de Revit en una sola suscripción. Pensado para iniciarte en modelado BIM.',
      'autocad-lt-mac': 'AutoCAD LT para Mac: la misma versión 2D de AutoCAD LT, pero nativa para macOS.',
      'autocad-raster-design': 'AutoCAD Raster Design: permite editar y vectorizar imágenes escaneadas (planos antiguos, mapas) directamente dentro de AutoCAD.',
      'autocad-web': 'AutoCAD Web: versión en el navegador, sin instalación, para ver y editar tus planos desde cualquier dispositivo.',
      '3ds-max': '3ds Max: modelado, animación y renderizado 3D, usado en arquitectura, diseño de producto y visualización.',
      'mudbox': 'Mudbox: esculpido y pintura digital 3D de alto detalle, usado para texturizar modelos.',
      'flow-studio': 'Flow Studio: herramientas de postproducción y composición de video/efectos visuales (planes Standard / Pro / Enterprise).',
      'navpack': 'NavPack (Navisworks): revisión y coordinación de modelos BIM de varias disciplinas, con detección de interferencias.',
      'otro': '¿No estás seguro de qué licencia necesitas? Cuéntanos tu proyecto en los comentarios y te asesoramos sobre la opción correcta.',
    };

    // Al marcar/desmarcar un producto, muestra sus descripciones en el recuadro amarillo
    function actualizarInfoProductos() {
      if (!adProductosInfo) return;
      const seleccionados = Array.from(
        document.querySelectorAll('input[name="productos"]:checked')
      ).map((el) => (el as HTMLInputElement).value);

      if (seleccionados.length === 0) {
        adProductosInfo.classList.add('hidden');
        adProductosInfo.innerHTML = '';
        return;
      }

      adProductosInfo.innerHTML = seleccionados
        .map((valor) => `<p>💡 ${descripcionesProductos[valor] || ''}</p>`)
        .join('');
      adProductosInfo.classList.remove('hidden');
    }

    document.querySelectorAll('input[name="productos"]').forEach((checkbox) => {
      checkbox.addEventListener('change', actualizarInfoProductos);
    });

    // Muestra/oculta el campo de User ID de Autodesk según el tipo de solicitud
    document.querySelectorAll('input[name="tipoSolicitud"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const esRenovacion = (e.target as HTMLInputElement).value === 'renovacion';
        adRenovacionCampo?.classList.toggle('hidden', !esRenovacion);
        if (adUserIdInput) adUserIdInput.required = esRenovacion;
      });
    });

    if (adForm && adBtn) {
      adForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        adSuccess?.classList.add('hidden');
        adError?.classList.add('hidden');

        const productosSeleccionados = Array.from(
          adForm.querySelectorAll('input[name="productos"]:checked')
        ).map((el) => (el as HTMLInputElement).value);

        if (productosSeleccionados.length === 0) {
          if (adError) {
            adError.textContent = 'Selecciona al menos un producto de tu interés.';
            adError.classList.remove('hidden');
          }
          return;
        }

        adBtn.disabled = true;
        adSpinner?.classList.remove('hidden');
        const adBtnText = adBtn.querySelector('span');
        if (adBtnText) adBtnText.textContent = 'Enviando...';

        const formData = new FormData(adForm);
        const data = {
          nombre: formData.get('nombre'),
          correo: formData.get('correo'),
          telefono: formData.get('telefono'),
          empresa: formData.get('empresa'),
          tipoSolicitud: formData.get('tipoSolicitud'),
          userIdAutodesk: formData.get('userIdAutodesk'),
          productos: productosSeleccionados,
          cantidad: formData.get('cantidad'),
          plazo: formData.get('plazo'),
          comentarios: formData.get('comentarios'),
        };

        try {
          const response = await fetch('/api/cotizar-autodesk/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          let result;
          try {
            result = await response.json();
          } catch {
            throw new Error(`Error del servidor (${response.status}). Inténtalo de nuevo.`);
          }

          if (response.ok && result.success) {
            adSuccess?.classList.remove('hidden');
            adForm.reset();
            adRenovacionCampo?.classList.add('hidden');
          } else {
            if (adError) {
              adError.textContent = result.message || 'Ocurrió un error al enviar tu solicitud. Inténtalo de nuevo.';
              adError.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (adError) {
            const errMsg = err instanceof Error ? err.message : 'Error de red. Verifica tu conexión e inténtalo de nuevo.';
            adError.textContent = errMsg;
            adError.classList.remove('hidden');
          }
        } finally {
          adBtn.disabled = false;
          adSpinner?.classList.add('hidden');
          if (adBtnText) adBtnText.textContent = 'Solicitar Cotización';
        }
      });
    }
  </script>

</BaseLayout>