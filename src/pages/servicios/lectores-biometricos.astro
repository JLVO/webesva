---
import Navbar from "../../components/Navbar.astro";
import Hero from "../../components/Hero.astro";
import { getCollection, type CollectionEntry } from 'astro:content';
import "../../styles/global.css";
import LlamadaAction from "../../components/LlamadaAction.astro";
import PreguntasFrecuentes from '../../components/PreguntasFrecuentes.astro';
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";

// Lógica para obtener los posts del blog
const MAX_RECENT_POSTS = 3;
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, MAX_RECENT_POSTS);

const preguntasLectores = [
  {
    titulo: '¿Qué tipo de lector biométrico es mejor para mi negocio?',
    respuesta:
      'Depende del nivel de seguridad y el flujo de personal. Ofrecemos lectores de huella digital, reconocimiento facial y de tarjetas de proximidad. Te ayudamos a elegir el más adecuado.',
  },
  {
    titulo: '¿Se puede integrar con mi sistema de planillas?',
    respuesta:
      'Sí, muchos de nuestros sistemas de control de asistencia se pueden integrar con software de planillas y RRHH para automatizar el cálculo de horas trabajadas.',
  },
  {
    titulo: '¿Es complicado de usar para los empleados?',
    respuesta:
      'No, los sistemas son muy intuitivos. El registro es rápido y el marcado diario toma solo un segundo. Ofrecemos capacitación completa a tu personal.',
  },
  {
    titulo: '¿Qué pasa si un lector falla?',
    respuesta:
      'Ofrecemos garantía y soporte técnico para todos nuestros equipos. Contamos con planes de mantenimiento preventivo para minimizar cualquier incidencia.',
  },
];
---

¡<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lectores Biométricos para Empresas en Piura | ESVA</title>
    <meta name="description" content="Moderniza el control de asistencia y acceso en tu empresa con lectores biométricos de huella digital y reconocimiento facial en Piura. Instalación y configuración profesional.">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-365MN03V4H"></script>
<script is:inline>
    
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-365MN03V4H');
    </script>

    <!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-W7XKNX23');</script>
<!-- End Google Tag Manager -->
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W7XKNX23"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <Navbar/>
    <Hero  
  title="Control de Acceso y Asistencia con Lectores Biométricos" 
  subtitle="Optimiza la gestión de tu personal y refuerza la seguridad de tus instalaciones con tecnología biométrica de última generación."
  imageUrl="/public/imagenes/blog/integracion-biometricos-camaras-esva.jpg" 
  buttonText="Solicita una Demostración" 
  buttonLink="Escríbenos por WhatsApp"
  linkwhatsapp="https://wa.me/51985834886?text=Hola,%20estoy%20interesado%20en%20lectores%20biométricos%20para%20mi%20empresa.%20¿Podrían%20ayudarme?" 
/>


<section class="bg-white py-16 px-6 md:px-20 text-center">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">Precisión y Seguridad para tu Empresa</h2>
    <p class="text-lg text-gray-700">
      Olvídate de los registros manuales y las tarjetas de acceso que se pierden. Con los <strong class="text-blue-700">lectores biométricos</strong>, la identidad de tu personal es la llave. Gestiona la asistencia y el acceso a áreas restringidas de forma segura y eficiente.
    </p>
  </div>
</section>


<section class="bg-blue-50 py-16 px-6 md:px-20">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-12">Nuestros Servicios de Control Biométrico</h2>
    <div class="grid gap-8 md:grid-cols-3">
      <!-- Tarjeta 1 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M7 11.5a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zm12.75 4.5a.75.75 0 000-1.5h-.75a5.25 5.25 0 00-4.5-4.5h-3a5.25 5.25 0 00-4.5 4.5H6a.75.75 0 000 1.5h.75a5.25 5.25 0 004.5 4.5h3a5.25 5.25 0 004.5-4.5h.75z"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Control de Asistencia</h3>
        <p class="text-gray-600">Registra la hora de entrada y salida de tu personal con precisión biométrica para una gestión de nómina sin errores.</p>
      </div>

      <!-- Tarjeta 2 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 11c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Control de Acceso</h3>
        <p class="text-gray-600">Asegura zonas restringidas permitiendo el ingreso solo a personal autorizado mediante huella o rostro.</p>
      </div>

      <!-- Tarjeta 3 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M17 14v6m-5-12v12m-5-6v6m-5-12v12M3 3h18"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Reportes y Software</h3>
        <p class="text-gray-600">Software de gestión para generar reportes detallados de asistencia, puntualidad, horas extra y más.</p>
      </div>
    </div>
  </div>
</section>


<LlamadaAction  
  title="¿Quieres modernizar el control en tu empresa?"  
  subtitle="Descubre cómo nuestros sistemas biométricos pueden ahorrarte tiempo, dinero y mejorar la seguridad. Solicita una asesoría gratuita."
  buttonTextContato="Contáctanos"  
  buttonLinkLlamada="Llámanos Ahora"  
  linkwhatsapp="https://wa.me/51985834886?text=Hola,%20necesito%20información%20sobre%20los%20lectores%20biométricos%20de%20ESVA."  
  textobotonwhatsapp="WhatsApp"
/>



<section class="bg-blue-50 py-20 px-6 md:px-20">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-12">Ventajas de Implementar un Sistema Biométrico</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 text-left">
      
      <!-- Beneficio 1 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Elimina la Suplantación</h3>
        <p class="text-gray-700">La identificación por huella o rostro es única e intransferible, evitando el "marcaje por amigo".</p>
      </div>

      <!-- Beneficio 2 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Ahorro de Tiempo y Costos</h3>
        <p class="text-gray-700">Automatiza el cálculo de horas y reduce la carga administrativa en el área de Recursos Humanos.</p>
      </div>

      <!-- Beneficio 3 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Información Centralizada</h3>
        <p class="text-gray-700">Accede a toda la información de asistencia y control de acceso desde un solo lugar y en tiempo real.</p>
      </div>

      <!-- Beneficio 4 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-800 mb-2">Mejora la Puntualidad</h3>
        <p class="text-gray-700">Fomenta una cultura de puntualidad al tener un registro preciso y automatizado de la asistencia.</p>
      </div>

      <!-- Beneficio 5 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Integración con Otros Sistemas</h3>
        <p class="text-gray-700">Nuestros sistemas pueden integrarse con su software de nóminas, ERP o sistemas de seguridad existentes.</p>
      </div>

      <!-- Beneficio 6 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Marcas Líderes</h3>
        <p class="text-gray-700">Trabajamos con marcas reconocidas como ZKTeco para ofrecerte equipos confiables y de alto rendimiento.</p>
      </div>

    </div>
  </div>
</section>

<!-- Sección del Blog -->
{recentPosts.length > 0 && (
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">
        Últimas Entradas de Nuestro Blog
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map(post => (
          <article class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
            {post.data.image?.url && (
              <a href={`/blog/${post.slug}/`} class="block aspect-video overflow-hidden group">
                <img 
                  src={typeof post.data.image.url === 'string' ? post.data.image.url : post.data.image.url} 
                  alt={post.data.image.alt || post.data.title} 
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" 
                  loading="lazy" 
                />
              </a>
            )}
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl font-semibold mb-3 text-gray-800">
                <a href={`/blog/${post.slug}/`} class="hover:text-blue-600 transition duration-300">
                  {post.data.title}
                </a>
              </h3>
              {post.data.description && (
                <p class="text-gray-600 text-sm mb-4 flex-grow">{post.data.description.slice(0, 100) + (post.data.description.length > 100 ? '...' : '')}</p>
              )}
              <p class="text-xs text-gray-500 mb-4">
                {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <div class="mt-auto pt-2">
                <a href={`/blog/${post.slug}/`} class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition duration-300">
                  Leer más <span aria-hidden="true" class="ml-1">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
      {allPosts.length > MAX_RECENT_POSTS && (
        <div class="text-center mt-12">
          <a href="/blog" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-full shadow-lg text-lg font-semibold hover:bg-blue-700 transition duration-300">
            Ver todos los posts
          </a>
        </div>
      )}
    </div>
  </section>
)}

<PreguntasFrecuentes preguntas={preguntasLectores} />

<Footer/>
<WhatsAppButton/>
</body>
</html>
