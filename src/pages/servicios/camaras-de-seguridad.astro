import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
 
 

 
---

<BaseLayout pageTitle="Instalación de Cámaras de Seguridad en Piura | ESVA" metaDescription="Protege tu hogar, negocio o condominio con nuestros sistemas de cámaras de seguridad profesionales en Piura. Instalación, configuración y mantenimiento garantizado." canonicalUrl={Astro.url.href} ogType="website">
  <Hero  
    title="Instalación de Cámaras de Seguridad" 
    subtitle="Protege lo que más importa con sistemas de videovigilancia profesionales. Soluciones a medida para hogares, empresas y condominios en Piura." 
    imageUrl="/imagenes/blog/tecnico-de-ESVA-instalando-camaras.jpg" 
    buttonText="Cotiza tu Proyecto" 
    buttonLink="Escríbenos por WhatsApp"
    linkwhatsapp="https://wa.me/51985834886?text=Hola,%20estoy%20interesado%20en%20un%20sistema%20de%20cámaras%20de%20seguridad.%20¿Me%20pueden%20asesorar?" 
    imageMaxWidth="max-w-xl" sectionPadding="py-16 md:py-20"
  />


<section class="bg-white py-16 px-6 md:px-20 text-center">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">Tu Tranquilidad es Nuestra Prioridad</h2>
    <p class="text-lg text-gray-700">
      Un sistema de cámaras de seguridad es tu mejor aliado para prevenir robos, disuadir intrusos y supervisar tu propiedad 24/7. En ESVA te ofrecemos <strong class="text-blue-700">tecnología de punta y una instalación impecable</strong> para que tengas control total y ojos en todas partes, desde cualquier lugar.
    </p>
  </div>
</section>


<section class="py-16 px-6 md:px-20 text-center">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-bold text-blue-900 mb-6">Soluciones en Videovigilancia</h2>
    <p class="text-lg text-gray-700">Diseñamos sistemas a medida para hogares, negocios y condominios en Piura.</p>
  </div>
</section>







