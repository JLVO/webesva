---
import Navbar from "../../components/Navbar.astro";
import Hero from "../../components/Hero.astro";
import { getCollection, type CollectionEntry } from 'astro:content';
import "../../styles/global.css";
import LlamadaAction from "../../components/LlamadaAction.astro";
import PreguntasFrecuentes from '../../components/PreguntasFrecuentes.astro';
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";

// Lógica para obtener los posts del blog
const MAX_RECENT_POSTS = 3;
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, MAX_RECENT_POSTS);

const preguntasCamaras = [
  {
    titulo: '¿Qué tipo de cámaras de seguridad necesito?',
    respuesta:
      'La elección depende de tus necesidades. Ofrecemos cámaras domo, bala, PTZ, con visión nocturna, para interior y exterior. En nuestra asesoría gratuita, evaluamos tu propiedad y te recomendamos la mejor opción para tu presupuesto y objetivos.',
  },
  {
    titulo: '¿Puedo ver las cámaras desde mi celular?',
    respuesta:
      '¡Por supuesto! Todas nuestras instalaciones incluyen la configuración de una aplicación móvil para que puedas monitorear tus cámaras en tiempo real desde tu smartphone, tablet o computadora, estés donde estés.',
  },
  {
    titulo: '¿Cuánto tiempo se guardan las grabaciones?',
    respuesta:
      'El tiempo de almacenamiento depende de la capacidad del disco duro del grabador (DVR/NVR) y la configuración. Te ayudamos a calcular el almacenamiento ideal para guardar desde 7 días hasta varios meses de video, según tus requerimientos.',
  },
  {
    titulo: '¿Ofrecen garantía por la instalación y los equipos?',
    respuesta:
      'Sí, ofrecemos una garantía completa que cubre tanto los equipos contra defectos de fábrica como la mano de obra de nuestra instalación. Además, contamos con planes de mantenimiento preventivo para asegurar la longevidad de tu sistema.',
  },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instalación de Cámaras de Seguridad en Piura | ESVA</title>
    <meta name="description" content="Protege tu hogar, negocio o condominio con nuestros sistemas de cámaras de seguridad profesionales en Piura. Instalación, configuración y mantenimiento garantizado.">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-365MN03V4H"></script>
<script is:inline>
    
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-365MN03V4H');
    </script>

    <!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-W7XKNX23');</script>
<!-- End Google Tag Manager -->
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W7XKNX23"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <Navbar/>
    <Hero  
  title="Instalación de Cámaras de Seguridad" 
  subtitle="Protege lo que más importa con sistemas de videovigilancia profesionales. Soluciones a medida para hogares, empresas y condominios en Piura." 
  imageUrl="/imagenes/blog/tecnico-de-ESVA-instalando-camaras.jpg" 
  buttonText="Cotiza tu Proyecto" 
  buttonLink="Escríbenos por WhatsApp"
  linkwhatsapp="https://wa.me/51985834886?text=Hola,%20estoy%20interesado%20en%20un%20sistema%20de%20cámaras%20de%20seguridad.%20¿Me%20pueden%20asesorar?" 
/>


<section class="bg-white py-16 px-6 md:px-20 text-center">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-6">Tu Tranquilidad es Nuestra Prioridad</h2>
    <p class="text-lg text-gray-700">
      Un sistema de cámaras de seguridad es tu mejor aliado para prevenir robos, disuadir intrusos y supervisar tu propiedad 24/7. En ESVA te ofrecemos <strong class="text-blue-700">tecnología de punta y una instalación impecable</strong> para que tengas control total y ojos en todas partes, desde cualquier lugar.
    </p>
  </div>
</section>


<section class="bg-blue-50 py-16 px-6 md:px-20">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-12">Nuestras Soluciones en Videovigilancia</h2>
    <div class="grid gap-8 md:grid-cols-3">
      <!-- Tarjeta 1 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.55a2 2 0 01.95 1.7V15a2 2 0 01-2 2H5a2 2 0 01-2-2v-3.3a2 2 0 01.95-1.7L8 10m7-5a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Cámaras de Alta Definición</h3>
        <p class="text-gray-600">Imágenes nítidas Full HD y 4K para que no te pierdas ningún detalle, de día o de noche (visión nocturna a color).</p>
      </div>

      <!-- Tarjeta 2 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Acceso Remoto Instantáneo</h3>
        <p class="text-gray-600">Vigila tu propiedad desde cualquier lugar del mundo a través de una aplicación segura en tu smartphone, tablet o PC.</p>
      </div>

      <!-- Tarjeta 3 -->
      <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition duration-300">
        <div class="text-blue-800 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-blue-800">Grabación Inteligente y Segura</h3>
        <p class="text-gray-600">Almacenamiento optimizado (24/7 o por detección de movimiento) para que no te pierdas los momentos clave.</p>
      </div>
    </div>
  </div>
</section>

<!-- NUEVA SECCIÓN: Soluciones para cada necesidad -->
<section class="bg-white py-20 px-6 md:px-20">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-4">Soluciones de Videovigilancia para Cada Necesidad</h2>
    <p class="text-lg text-gray-600 mb-12 max-w-3xl mx-auto">Diseñamos sistemas de seguridad a la medida, porque cada espacio tiene requerimientos únicos.</p>
    <div class="grid gap-10 md:grid-cols-3">
      <!-- Solución 1: Hogares -->
      <div class="bg-gray-50 p-8 rounded-lg shadow-lg hover:shadow-2xl transition-shadow duration-300">
        <div class="text-blue-600 mb-5">
          <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"></path></svg>
        </div>
        <h3 class="text-2xl font-bold mb-3 text-blue-800">Seguridad para Hogares</h3>
        <p class="text-gray-700">Protege a tu familia y tus bienes más preciados. Disuade a los intrusos y supervisa tu casa desde cualquier lugar, brindándote paz mental.</p>
      </div>

      <!-- Solución 2: Empresas -->
      <div class="bg-gray-50 p-8 rounded-lg shadow-lg hover:shadow-2xl transition-shadow duration-300">
        <div class="text-blue-600 mb-5">
          <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m-6-13.5h.008v.008H8.25v-.008zm0 4.5h.008v.008H8.25v-.008zm0 4.5h.008v.008H8.25v-.008zm4.5-4.5h.008v.008h-.008v-.008zm0 4.5h.008v.008h-.008v-.008zm4.5-4.5h.008v.008h-.008v-.008zm0 4.5h.008v.008h-.008v-.008z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold mb-3 text-blue-800">Vigilancia para Negocios</h3>
        <p class="text-gray-700">Supervisa tus operaciones, protege tus activos y mejora la seguridad de empleados y clientes. Reduce pérdidas y optimiza la productividad.</p>
      </div>

      <!-- Solución 3: Condominios -->
      <div class="bg-gray-50 p-8 rounded-lg shadow-lg hover:shadow-2xl transition-shadow duration-300">
        <div class="text-blue-600 mb-5">
          <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m-7.5-2.963A3.004 3.004 0 0012 15a3 3 0 10-3-3m10.5 6H13.5c-1.657 0-3-1.343-3-3V6.75a3 3 0 013-3h5.25a3 3 0 013 3v6.75a3 3 0 01-3 3z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold mb-3 text-blue-800">Protección para Condominios</h3>
        <p class="text-gray-700">Aumenta la seguridad en áreas comunes, controla accesos y brinda tranquilidad a todos los residentes con un sistema de vigilancia centralizado.</p>
      </div>
    </div>
  </div>
</section>

<LlamadaAction  
  title="¿Listo para dar el siguiente paso en seguridad?"  
  subtitle="No dejes la protección de tu patrimonio al azar. Contáctanos hoy y un especialista te brindará una cotización gratuita y sin compromiso, 100% adaptada a tus necesidades."  
  buttonTextContato="Contáctanos"  
  buttonLinkLlamada="Llámanos Ahora"  
  linkwhatsapp="https://wa.me/51985834886?text=Hola,%20quisiera%20cotizar%20un%20sistema%20de%20cámaras%20de%20seguridad."  
  textobotonwhatsapp="WhatsApp"
/>

<section class="bg-blue-50 py-20 px-6 md:px-20">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-12">¿Por Qué Instalar tus Cámaras con ESVA?</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 text-left">
      
      <!-- Beneficio 1 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Asesoría 100% Personalizada</h3>
        <p class="text-gray-700">Evaluamos tu propiedad, escuchamos tus necesidades y te recomendamos la mejor solución en cámaras y equipos de grabación.</p>
      </div>

      <!-- Beneficio 2 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Instalación Profesional y Estética</h3>
        <p class="text-gray-700">Nuestros técnicos calificados cuidan cada detalle para garantizar una instalación segura, funcional y que respeta la estética de tu propiedad.</p>
      </div>

      <!-- Beneficio 3 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Configuración y Capacitación Completa</h3>
        <p class="text-gray-700">Dejamos tu sistema 100% operativo (PC y móvil) y te enseñamos a usarlo para que le saques el máximo provecho desde el primer día.</p>
      </div>

      <!-- Beneficio 4 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-800 mb-2">Equipos de Marcas Líderes</h3>
        <p class="text-gray-700">Solo trabajamos con las mejores marcas del mercado como Hikvision y Dahua para garantizar durabilidad, confianza y calidad de imagen.</p>
      </div>

      <!-- Beneficio 5 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Soporte Post-Venta Real</h3>
        <p class="text-gray-700">Ofrecemos soporte técnico rápido y eficiente, además de planes de mantenimiento para que tu sistema esté siempre operativo.</p>
      </div>

      <!-- Beneficio 6 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition duration-300">
        <h3 class="text-xl font-semibold text-blue-900 mb-2">Garantía Total en Equipos y Servicio</h3>
        <p class="text-gray-700">Todos nuestros productos e instalaciones cuentan con una garantía total contra defectos de fábrica y fallas en la instalación.</p>
      </div>

    </div>
  </div>
</section>

<!-- NUEVA SECCIÓN: Marcas -->
<section class="bg-white py-16">
  <div class="max-w-5xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold text-gray-800 mb-4">Trabajamos con las Marcas Líderes del Mercado</h2>
    <p class="text-gray-600 mb-10">Para asegurar la calidad, durabilidad y el mejor rendimiento, confiamos solo en los mejores.</p>
    <div class="flex justify-center items-center gap-12 md:gap-16 flex-wrap">
      <img src="/LogoHikvision.svg" alt="Logo Hikvision" class="h-12 lg:h-14 opacity-80 hover:opacity-100 transition-opacity"/>
      <img src="/LogoDahua.svg" alt="Logo Dahua" class="h-12 lg:h-14 opacity-80 hover:opacity-100 transition-opacity"/>
      <img src="/LogoZKTecoNuevo.svg" alt="Logo ZKTeco" class="h-16 lg:h-20 opacity-80 hover:opacity-100 transition-opacity"/>
      <img src="/LogoUbiquiti.svg" alt="Logo Ubiquiti" class="h-12 lg:h-14 opacity-80 hover:opacity-100 transition-opacity"/>
    </div>
  </div>
</section>


<!-- Sección del Blog -->
{recentPosts.length > 0 && (
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">
        Aprende Más en Nuestro Blog
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map(post => (
          <article class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
            {post.data.image?.url && (
              <a href={`/blog/${post.slug}/`} class="block aspect-video overflow-hidden group">
                <img 
                  src={typeof post.data.image.url === 'string' ? post.data.image.url : post.data.image.url} 
                  alt={post.data.image.alt || post.data.title} 
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" 
                  loading="lazy" 
                />
              </a>
            )}
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl font-semibold mb-3 text-gray-800">
                <a href={`/blog/${post.slug}/`} class="hover:text-blue-600 transition duration-300">
                  {post.data.title}
                </a>
              </h3>
              {post.data.description && (
                <p class="text-gray-600 text-sm mb-4 flex-grow">{post.data.description.slice(0, 100) + (post.data.description.length > 100 ? '...' : '')}</p>
              )}
              <p class="text-xs text-gray-500 mb-4">
                {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <div class="mt-auto pt-2">
                <a href={`/blog/${post.slug}/`} class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition duration-300">
                  Leer más <span aria-hidden="true" class="ml-1">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
      {allPosts.length > MAX_RECENT_POSTS && (
        <div class="text-center mt-12">
          <a href="/blog" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-full shadow-lg text-lg font-semibold hover:bg-blue-700 transition duration-300">
            Ver todos los posts
          </a>
        </div>
      )}
    </div>
  </section>
)}

<PreguntasFrecuentes preguntas={preguntasCamaras} />

<Footer/>
<WhatsAppButton/>
</body>
</html>
