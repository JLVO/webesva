<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Funcionalidad para acordeón de preguntas frecuentes
    const faqQuestions = document.querySelectorAll('.faq-question');
    
    faqQuestions.forEach(question => {
      question.addEventListener('click', () => {
        const answer = question.nextElementSibling;
        const icon = question.querySelector('svg');
        // Verificar si answer existe antes de continuar
        if (answer) {
          // Cerrar otras respuestas
          document.querySelectorAll('.faq-answer').forEach(ans => {
            if (ans !== answer) {
              ans.classList.add('hidden');
              ans.previousElementSibling?.querySelector('svg')?.classList.remove('rotate-180');
            }
          });
          
          // Alternar respuesta actual
          answer.classList.toggle('hidden');
          if (icon) {
            icon.classList.toggle('rotate-180');
          }
          
          // Animación suave
          if (!answer.classList.contains('hidden')) {
            (answer as HTMLElement).style.maxHeight = answer.scrollHeight + 'px';
          } else {
            (answer as HTMLElement).style.maxHeight = '0';
          }
        }
      });
    });
  });
</script>

<style>
  .faq-item {
    transition: all 0.3s ease;
