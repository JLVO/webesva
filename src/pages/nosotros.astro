---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Blog from "../components/Blog.astro";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Nosotros - ESVA Seguridad y Soporte Técnico de Confianza</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Definición de colores personalizados */
        :root {
            --primary: #1e40af;
            --secondary: #0e7490;
            --accent: #10b981;
            --dark: #0f172a;
            --light: #f0f9ff;
        }
        
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f9fafb;
        }
        .hero-bg {
            background: linear-gradient(135deg, rgba(30, 64, 175, 0.85) 0%, rgba(14, 116, 144, 0.9) 100%), url('https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80');
            background-size: cover;
            background-position: center;
        }

         /* Mejoras en el interlineado para el título */
    .hero-title {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      line-height: 1.3; /* Interlineado aumentado */
      letter-spacing: -0.5px;
    }

        .timeline-item {
            position: relative;
            padding-left: 30px;
            margin-bottom: 40px;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 8px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background-color: var(--primary);
            border: 3px solid #bfdbfe;
        }
        .timeline-item::after {
            content: '';
            position: absolute;
            left: 7px;
            top: 24px;
            width: 2px;
            height: calc(100% + 24px);
            background-color: #bfdbfe;
        }
        .timeline-item:last-child::after {
            display: none;
        }
        .value-card {
            transition: all 0.3s ease;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        .value-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .tech-card {
            transition: all 0.3s ease;
            border-radius: 12px;
            overflow: hidden;
        }
        .tech-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        .stats-item {
            position: relative;
            z-index: 1;
        }
        .stats-item::after {
            content: '';
            position: absolute;
            top: -10px;
            right: -10px;
            width: 60px;
            height: 60px;
            background-color: #dbeafe;
            border-radius: 50%;
            z-index: -1;
            opacity: 0.5;
        }
        .divider {
            height: 1px;
            background: linear-gradient(to right, transparent, var(--primary), transparent);
        }
        
        /* Utilidades de color */
        .text-primary { color: var(--primary); }
        .bg-primary { background-color: var(--primary); }
        .text-secondary { color: var(--secondary); }
        .bg-secondary { background-color: var(--secondary); }
        .text-accent { color: var(--accent); }
        .bg-accent { background-color: var(--accent); }
        .text-dark { color: var(--dark); }
        .bg-dark { background-color: var(--dark); }
        .text-light { color: var(--light); }
        .bg-light { background-color: var(--light); }
        
        .hover\:bg-green-600:hover { background-color: #059669; }
        .bg-gradient-to-r { background-image: linear-gradient(to right, var(--tw-gradient-stops)); }
        .from-primary { --tw-gradient-from: var(--primary); }
        .to-secondary { --tw-gradient-to: var(--secondary); }
        .text-blue-100 { color: #dbeafe; }
    </style>
  </head>
  <body class="bg-light" >
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W7XKNX23"
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <main>
      <Navbar />
      
      <!-- Hero Section -->
      <section class="hero-bg text-white py-24 px-4 text-center">
        <div class="max-w-4xl mx-auto">
          
          <h1 class="text-4x1 md:text-5xl font-bold mb-6">Sobre <span class="text-accent">ESVA</span> Seguridad y Soporte Técnico de Confianza</h1>
      
          <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto">
            Protegiendo hogares y empresas en Perú con tecnología y compromiso desde 2022
          </p>
          <a href="#valores" class="bg-accent hover:bg-green-600 text-white font-bold py-3 px-8 rounded-full text-lg inline-block transition duration-300 shadow-lg">
            Conoce Nuestros Valores
          </a>
        </div>
      </section>

      <!-- Nuestra Historia -->
      <section class="py-20 px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-primary">Nuestra Historia</h2>
            <div class="divider w-24 h-1 mx-auto mt-4 mb-6"></div>

            <p class="text-lg leading-relaxed text-gray-600 mb-6">
                ESVA nació en el año <strong class="text-primary">2022</strong> con una misión clara: brindar <strong class="text-primary">soluciones confiables en soporte técnico</strong> y <strong class="text-primary">seguridad electrónica</strong> para hogares y empresas peruanas. Empezamos como un pequeño emprendimiento familiar, motivados por la necesidad de ofrecer un servicio cercano, accesible y eficiente en un sector cada vez más digitalizado.
              </p>
          </div>

          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              
              
              <div class="timeline-item">
                <h3 class="text-xl font-bold mb-2">2022 - Nacimiento de ESVA</h3>
                <p class="text-gray-600">
                  Fundada como un emprendimiento familiar en Piura, con el objetivo de ofrecer soluciones de seguridad y soporte técnico accesibles y confiables.
                </p>
              </div>
              
              <div class="timeline-item">
                <h3 class="text-xl font-bold mb-2">2023 - Expansión de Servicios</h3>
                <p class="text-gray-600">
                  Incorporamos sistemas biométricos y videovigilancia avanzada, atendiendo a empresas medianas y grandes.
                </p>
              </div>
              
              <div class="timeline-item">
                <h3 class="text-xl font-bold mb-2">2024 - Crecimiento Regional</h3>
                <p class="text-gray-600">
                  Llegamos a más regiones del norte de Perú, consolidando nuestra red de técnicos y clientes corporativos.
                </p>
              </div>
              
              <div class="timeline-item">
                <h3 class="text-xl font-bold mb-2">2025 - Innovación Tecnológica</h3>
                <p class="text-gray-600">
                  Implementamos soluciones IoT y monitoreo remoto, ofreciendo seguridad 24/7 con acceso desde cualquier dispositivo.
                </p>
              </div>
              
            </div>
            
            <div class="w-full h-96 rounded-xl overflow-hidden shadow-lg">
              <!-- Imagen representativa de la historia de ESVA -->
              <img src="/NosotrosEquipoEsva.svg" alt="El equipo de ESVA en una reunión de planificación estratégica" class="w-full h-full object-cover">
            </div>
          </div>
        </div>
      </section>

      <!-- Estadísticas -->
      <section class="py-16 bg-gradient-to-r from-primary to-secondary text-white">
        <div class="max-w-6xl mx-auto px-4">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div class="stats-item">
              <p class="text-4xl md:text-5xl font-bold mb-2">4+</p>
              <p class="text-blue-100">Años de Experiencia</p>
            </div>
            <div class="stats-item">
              <p class="text-4xl md:text-5xl font-bold mb-2">100+</p>
              <p class="text-blue-100">Clientes Satisfechos</p>
            </div>
            <div class="stats-item">
              <p class="text-4xl md:text-5xl font-bold mb-2">200+</p>
              <p class="text-blue-100">Proyectos Completados</p>
            </div>
            <div class="stats-item">
              <p class="text-4xl md:text-5xl font-bold mb-2">15+</p>
              <p class="text-blue-100">Técnicos Especializados</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Nuestros Valores -->
      <section id="valores" class="py-20 px-4 bg-white">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-primary">Nuestros Valores y Compromisos</h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              Principios que guían cada acción y decisión en ESVA Seguridad
            </p>
            <div class="divider w-24 h-1 mx-auto mt-4"></div>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="value-card bg-light p-8">
              <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-handshake text-3xl text-primary"></i>
              </div>
              <h3 class="text-xl font-bold mb-3">Confianza</h3>
              <p class="text-gray-600">
                Construimos relaciones sólidas con nuestros clientes basadas en la honestidad, la transparencia y la responsabilidad en cada servicio que brindamos.
              </p>
            </div>
            
            <div class="value-card bg-light p-8">
              <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-lightbulb text-3xl text-primary"></i>
              </div>
              <h3 class="text-xl font-bold mb-3">Innovación</h3>
              <p class="text-gray-600">
                Apostamos por soluciones modernas en soporte técnico y seguridad, integrando tecnologías como lectores biométricos, cámaras IP, y redes eficientes.
              </p>
            </div>
            
            <div class="value-card bg-light p-8">
              <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-heart text-3xl text-primary"></i>
              </div>
              <h3 class="text-xl font-bold mb-3">Compromiso</h3>
              <p class="text-gray-600">
                Cada instalación, mantenimiento o asesoría es ejecutada con profesionalismo y dedicación. Estamos contigo antes, durante y después del servicio.
              </p>
            </div>
            
            <div class="value-card bg-light p-8">
              <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-universal-access text-3xl text-primary"></i>
              </div>
              <h3 class="text-xl font-bold mb-3">Accesibilidad</h3>
              <p class="text-gray-600">
                Creemos que la tecnología debe estar al alcance de todos. Por eso ofrecemos precios justos y atención personalizada para hogares, negocios y entidades.
              </p>
            </div>
            
            <div class="value-card bg-light p-8">
              <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-award text-3xl text-primary"></i>
              </div>
              <h3 class="text-xl font-bold mb-3">Calidad Técnica</h3>
              <p class="text-gray-600">
                Nuestro equipo técnico está capacitado constantemente para garantizar soluciones duraderas, seguras y efectivas en cada intervención.
              </p>
            </div>
            
            <div class="value-card bg-light p-8">
              <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-headset text-3xl text-primary"></i>
              </div>
              <h3 class="text-xl font-bold mb-3">Soporte Continuo</h3>
              <p class="text-gray-600">
                Más allá de la instalación, estamos disponibles para acompañarte. Brindamos asistencia técnica confiable cuando más lo necesitas.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Llamada a la acción mejorada -->
      <section class="py-20 px-4 bg-gradient-to-r from-primary to-secondary">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">¿Listo para llevar la seguridad al siguiente nivel?</h2>
          <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
            Contáctanos hoy mismo y descubre cómo podemos ayudarte a proteger tu entorno con tecnología confiable y soporte personalizado.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="tel:+51985834886" class="bg-white text-primary font-bold py-3 px-8 rounded-full inline-block hover:bg-gray-100 transition duration-300 shadow-lg">
              <i class="fas fa-phone mr-2"></i> LLámanos Ahora
            </a>
            <a href="https://wa.me/51985834886?text=Hola%20ESVA%20Seguridad,%20estoy%20interesado%20en%20obtener%20más%20información%20sobre%20sus%20servicios%20de%20seguridad%20y%20soporte%20técnico.%20¿Podrían%20brindarme%20más%20detalles?" target="_blank" class="bg-accent hover:bg-green-600 text-white font-bold py-3 px-8 rounded-full inline-block transition duration-300 shadow-lg">
              <i class="fab fa-whatsapp mr-2"></i> Escríbenos por WhatsApp
            </a>
          </div>
        </div>
      </section>

      <!-- Tecnologías y Servicios -->
      <section class="py-20 px-4 bg-light">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-primary">Tecnologías y Servicios Especializados</h2>
            <p class="text-lg text-gray-600 mb-12 max-w-3xl mx-auto">
              En ESVA, combinamos tecnología de vanguardia con atención personalizada para brindarte soluciones confiables en seguridad y soporte técnico.
            </p>
            <div class="divider w-24 h-1 mx-auto"></div>
          </div>

          <div class="grid md:grid-cols-3 sm:grid-cols-2 gap-8">
            <div class="tech-card bg-white rounded-xl p-6 shadow">
              <div class="text-primary mb-4">
                <i class="fas fa-tools text-4xl"></i>
              </div>
              <h3 class="text-xl font-semibold mb-2">Soporte Técnico Integral</h3>
              <p class="text-gray-600 text-sm">
                Mantenimiento, reparación, formateo e instalación de software en equipos informáticos.
              </p>
            </div>

            <div class="tech-card bg-white rounded-xl p-6 shadow">
              <div class="text-primary mb-4">
                <i class="fas fa-video text-4xl"></i>
              </div>
              <h3 class="text-xl font-semibold mb-2">Cámaras de Seguridad</h3>
              <p class="text-gray-600 text-sm">
                Instalación y configuración de sistemas de videovigilancia con monitoreo remoto.
              </p>
            </div>

            <div class="tech-card bg-white rounded-xl p-6 shadow">
              <div class="text-primary mb-4">
                <i class="fas fa-fingerprint text-4xl"></i>
              </div>
              <h3 class="text-xl font-semibold mb-2">Control Biométrico</h3>
              <p class="text-gray-600 text-sm">
                Lectores de huella, rostro y tarjeta para control de asistencia y acceso seguro.
              </p>
            </div>

            <div class="tech-card bg-white rounded-xl p-6 shadow">
              <div class="text-primary mb-4">
                <i class="fas fa-network-wired text-4xl"></i>
              </div>
              <h3 class="text-xl font-semibold mb-2">Redes y Conectividad</h3>
              <p class="text-gray-600 text-sm">
                Instalación de redes LAN/WiFi, configuración de routers y cableado estructurado.
              </p>
            </div>

            <div class="tech-card bg-white rounded-xl p-6 shadow">
              <div class="text-primary mb-4">
                <i class="fas fa-bell text-4xl"></i>
              </div>
              <h3 class="text-xl font-semibold mb-2">Alarmas y Sensores</h3>
              <p class="text-gray-600 text-sm">
                Sistemas de alarma para hogares y negocios, con sensores de movimiento y notificaciones.
              </p>
            </div>

            <div class="tech-card bg-white rounded-xl p-6 shadow">
              <div class="text-primary mb-4">
                <i class="fas fa-chalkboard-teacher text-4xl"></i>
              </div>
              <h3 class="text-xl font-semibold mb-2">Capacitación y Asesoría</h3>
              <p class="text-gray-600 text-sm">
                Asesoramiento técnico y capacitaciones para clientes sobre el uso de sus sistemas.
              </p>
            </div>
          </div>
        </div>
      </section> 
      
      <Blog/>
      <Footer/>
      <WhatsAppButton/>
    </main>
  </body>
</html>