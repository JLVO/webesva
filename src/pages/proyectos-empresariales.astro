---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import LlamadaAction from "../components/LlamadaAction.astro";
import PreguntasFrecuentes from "../components/PreguntasFrecuentes.astro";
import GaleriaCarrusel from "../components/GaleriaCarrusel.astro";
import type { Foto } from "../components/GaleriaCarrusel.astro";
import {
  Building2,
  Camera,
  Network,
  Server,
  ShieldCheck,
  Phone,
  FileCheck2,
  Layers,
  Wrench,
  Landmark,
  Sun,
  X,
  ChevronLeft,
  ChevronRight,
} from "lucide-react";

const whatsappText =
  "Hola ESVA, tengo un proyecto empresarial (redes, servidores, cámaras u otro) y quisiera una asesoría.";
const whatsappLink = `https://wa.me/51985834886?text=${encodeURIComponent(whatsappText)}`;

// Fotos reales de cada proyecto. Se completan a medida que Luis las envía —
// nunca poner aquí imágenes genéricas/de stock que no sean del proyecto real.
// Nombres de archivo y alt descriptivos por foto (SEO).
const galeriaSolux: Foto[] = [
  { src: "/imagenes/proyectos/solux/soporte-starlink-mini-techo-camioneta-piura-esva.webp", alt: "Soporte de montaje para antena Starlink Mini sobre el techo de una camioneta de Solux Group SAC en Piura" },
  { src: "/imagenes/proyectos/solux/ensamblaje-base-starlink-mini-soporte-vehicular-piura-esva.webp", alt: "Ensamblaje de la base de la antena Starlink Mini en el soporte vehicular, proyecto Solux Group SAC" },
  { src: "/imagenes/proyectos/solux/antena-starlink-mini-montada-soporte-caja-piura-esva.webp", alt: "Antena Starlink Mini montada sobre su soporte, junto a la caja original, instalación Solux Group SAC" },
  { src: "/imagenes/proyectos/solux/antena-starlink-mini-lista-instalar-camioneta-piura-esva.webp", alt: "Antena Starlink Mini ensamblada y lista para instalar en camioneta de trabajo, Solux Group SAC" },
  { src: "/imagenes/proyectos/solux/antena-starlink-mini-instalada-techo-camioneta-piura-esva.webp", alt: "Antena Starlink Mini instalada en el techo de una camioneta de Solux Group SAC en Piura" },
  { src: "/imagenes/proyectos/solux/antena-starlink-mini-camioneta-patio-operaciones-piura-esva.webp", alt: "Camioneta de Solux Group SAC con antena Starlink Mini instalada en el patio de operaciones" },
  { src: "/imagenes/proyectos/solux/camioneta-antena-starlink-mini-exterior-oficina-piura-esva.webp", alt: "Camioneta con antena Starlink Mini instalada, estacionada frente a las oficinas de Solux Group SAC" },
  { src: "/imagenes/proyectos/solux/cableado-antena-starlink-mini-techo-vehiculo-piura-esva.webp", alt: "Cableado de la antena Starlink Mini en el techo del vehículo, instalación Solux Group SAC" },
  { src: "/imagenes/proyectos/solux/soporte-alternativo-starlink-mini-camioneta-piura-esva.webp", alt: "Soporte alternativo para antena Starlink Mini en camioneta, proyecto Solux Group SAC" },
];
const galeriaAgronutricion: Foto[] = [
  { src: "/imagenes/proyectos/agronutricion/tecnicos-instalando-fibra-optica-rack-agronutricion-piura-esva.webp", alt: "Técnicos de ESVA instalando cableado de fibra óptica en rack de comunicaciones, proyecto Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/instalacion-gabinete-red-pared-obra-agronutricion-piura-esva.webp", alt: "Instalación de gabinete de red en pared durante la obra civil de Agronutrición en Piura" },
  { src: "/imagenes/proyectos/agronutricion/tecnico-configurando-switch-gabinete-agronutricion-piura-esva.webp", alt: "Técnico configurando switch dentro de gabinete de red en Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/fachada-edificio-agronutricion-piura-esva.webp", alt: "Fachada del edificio corporativo de Agronutrición en Piura" },
  { src: "/imagenes/proyectos/agronutricion/access-point-wifi-empresarial-techo-agronutricion-piura-esva.webp", alt: "Access point WiFi empresarial instalado en el techo de las oficinas de Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/instalacion-computadora-oficina-agronutricion-piura-esva.webp", alt: "Instalación y configuración de computadora de escritorio en oficina de Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/instalacion-tomacorriente-red-escritorio-agronutricion-piura-esva.webp", alt: "Instalación de tomacorriente y punto de red en escritorio corporativo, Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/camara-seguridad-dahua-bullet-nueva-agronutricion-piura-esva.webp", alt: "Cámara de seguridad Dahua tipo bullet nueva, equipamiento para Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/camara-seguridad-dahua-doble-lente-agronutricion-piura-esva.webp", alt: "Cámara de seguridad Dahua de doble lente panorámica, equipamiento para Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/equipos-camaras-dahua-empaquetados-agronutricion-piura-esva.webp", alt: "Cámaras de seguridad Dahua empaquetadas, equipamiento del proyecto de videovigilancia en Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/nave-industrial-agronutricion-interior-piura-esva.webp", alt: "Vista interior de la nave industrial de Agronutrición durante la implementación de infraestructura" },
  { src: "/imagenes/proyectos/agronutricion/tecnico-plataforma-elevadora-cableado-techo-agronutricion-piura-esva.webp", alt: "Técnico en plataforma elevadora instalando cableado estructurado en el techo de la planta de Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/rack-servidores-switch-nvr-dahua-agronutricion-piura-esva.webp", alt: "Rack de servidores con switch y grabador NVR Dahua instalado en Agronutrición" },
  { src: "/imagenes/proyectos/agronutricion/gabinete-red-switch-satra-fibra-agronutricion-piura-esva.webp", alt: "Gabinete de red con switch Satra y fibra óptica organizada, proyecto Agronutrición" },
];
const galeriaJtExpress: Foto[] = [
  { src: "/imagenes/proyectos/jtexpress/equipos-camaras-hikvision-colorvu-jtexpress-piura-esva.webp", alt: "Cámaras de seguridad Hikvision ColorVu empaquetadas, equipamiento del proyecto J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/nvr-hikvision-discos-duros-jtexpress-piura-esva.webp", alt: "Grabador NVR Hikvision con discos duros de almacenamiento para videovigilancia, J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/instalacion-discos-duros-nvr-jtexpress-piura-esva.webp", alt: "Instalación de discos duros dentro del NVR Hikvision, proyecto J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/camara-domo-interior-instalada-jtexpress-piura-esva.webp", alt: "Cámara de seguridad domo instalada en interior de las instalaciones de J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/camara-seguridad-pared-ladrillo-exterior-jtexpress-piura-esva.webp", alt: "Cámara de seguridad tipo bullet instalada en pared exterior de ladrillo, J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/camara-bullet-pared-exterior-almacen-jtexpress-piura-esva.webp", alt: "Cámara bullet instalada en pared exterior del almacén de J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/camara-seguridad-esquina-pared-jtexpress-piura-esva.webp", alt: "Cámara de seguridad instalada en esquina de pared perimetral, J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/camara-bullet-techo-almacen-exterior-jtexpress-piura-esva.webp", alt: "Cámara bullet instalada junto al techo del almacén exterior de J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/camara-perimetral-cableado-exterior-jtexpress-piura-esva.webp", alt: "Cámara de seguridad perimetral con cableado exterior, instalación J&T Express" },
  { src: "/imagenes/proyectos/jtexpress/nvr-hikvision-instalado-pared-jtexpress-piura-esva.webp", alt: "Grabador NVR Hikvision instalado en pared, centro de monitoreo de J&T Express" },
];
const galeriaChiflesOlaechea: Foto[] = [
  { src: "/imagenes/proyectos/chifles-olaechea/antena-starlink-standard-techo-chifles-olaechea-piura-esva.webp", alt: "Antena Starlink Standard sobre el techo, previa a su instalación en Chifles Olaechea" },
  { src: "/imagenes/proyectos/chifles-olaechea/instalacion-antena-starlink-standard-techo-chifles-olaechea-piura-esva.webp", alt: "Instalación de la antena Starlink Standard en el techo del local de Chifles Olaechea" },
  { src: "/imagenes/proyectos/chifles-olaechea/tecnico-sosteniendo-antena-starlink-standard-chifles-olaechea-piura-esva.webp", alt: "Técnico de ESVA sosteniendo la antena Starlink Standard durante la instalación en Chifles Olaechea" },
  { src: "/imagenes/proyectos/chifles-olaechea/equipos-camaras-ezviz-herramientas-chifles-olaechea-piura-esva.webp", alt: "Cámaras de seguridad EZVIZ y herramientas de instalación sobre el techo de Chifles Olaechea" },
  { src: "/imagenes/proyectos/chifles-olaechea/camara-ezviz-panel-solar-poste-chifles-olaechea-piura-esva.webp", alt: "Cámara de seguridad EZVIZ alimentada con panel solar instalada en poste, Chifles Olaechea" },
  { src: "/imagenes/proyectos/chifles-olaechea/calibracion-app-starlink-obstrucciones-chifles-olaechea-piura-esva.webp", alt: "App de Starlink calibrando el mapa de obstrucciones de la antena en Chifles Olaechea" },
  { src: "/imagenes/proyectos/chifles-olaechea/velocidad-internet-starlink-resultados-chifles-olaechea-piura-esva.webp", alt: "Resultados de velocidad de internet satelital Starlink en Chifles Olaechea" },
  { src: "/imagenes/proyectos/chifles-olaechea/app-starlink-calibrando-cobertura-chifles-olaechea-piura-esva.webp", alt: "App de Starlink calibrando la cobertura de la antena instalada en Chifles Olaechea" },
];
const galeriaEconogas: Foto[] = [];
const galeriaNorandino: Foto[] = [
  { src: "/imagenes/proyectos/norandino/equipos-camaras-hikvision-nvr-norandino-piura-esva.webp", alt: "Cámaras de seguridad Hikvision y grabador NVR, equipamiento del proyecto de videovigilancia en Norandino" },
  { src: "/imagenes/proyectos/norandino/tecnicos-armando-soporte-camara-planta-norandino-piura-esva.webp", alt: "Técnicos armando el soporte metálico para cámaras en la planta de procesamiento de Norandino" },
  { src: "/imagenes/proyectos/norandino/tecnico-instalando-camara-altura-planta-norandino-piura-esva.webp", alt: "Técnico instalando cámara de seguridad en altura dentro de la planta de Norandino" },
  { src: "/imagenes/proyectos/norandino/tecnicos-andamio-cableado-planta-norandino-piura-esva.webp", alt: "Técnicos sobre andamio instalando cableado de videovigilancia en la planta de Norandino" },
  { src: "/imagenes/proyectos/norandino/andamio-instalacion-camaras-planta-cafe-norandino-piura-esva.webp", alt: "Andamio de trabajo para la instalación de cámaras en la planta de café de Norandino" },
  { src: "/imagenes/proyectos/norandino/almacen-cafe-pergamino-camaras-seguridad-norandino-piura-esva.webp", alt: "Instalación de cámaras de seguridad en el almacén de café pergamino de Norandino" },
];

const galleriesData = {
  solux: galeriaSolux,
  agronutricion: galeriaAgronutricion,
  jtexpress: galeriaJtExpress,
  chifles: galeriaChiflesOlaechea,
  econogas: galeriaEconogas,
  norandino: galeriaNorandino,
};

const preguntasProyectos = [
  {
    titulo: "¿Trabajan proyectos fuera de Piura?",
    respuesta:
      "Sí, tenemos proyección a clientes empresariales del norte del país. Coordinamos visita técnica, cronograma y logística según la ubicación de la planta u oficina.",
  },
  {
    titulo: "¿Entregan documentación técnica del proyecto?",
    respuesta:
      "Sí. Para proyectos empresariales elaboramos memoria descriptiva, especificaciones técnicas, matriz de cobertura (en CCTV) y documentación de instalación y operación, útil para tus propios procesos internos o de auditoría.",
  },
  {
    titulo: "¿Pueden integrar redes, servidores, cámaras y telefonía en un solo proyecto?",
    respuesta:
      "Sí, es justamente nuestro enfoque: diseñamos la infraestructura tecnológica de forma integral en vez de contratar cada área por separado con proveedores distintos.",
  },
  {
    titulo: "¿Qué marcas manejan en proyectos empresariales?",
    respuesta:
      "Trabajamos con equipos de nivel empresarial como Cisco y Mikrotik en redes, Hikvision/Dahua/Uniview en videovigilancia, y otras marcas según el requerimiento técnico y presupuesto del proyecto.",
  },
];
---

<BaseLayout
  pageTitle="Proyectos Empresariales de TI y Seguridad | ESVA"
  metaDescription="ESVA diseña e implementa infraestructura tecnológica empresarial en Piura: redes, servidores, firewall, videovigilancia y telefonía IP. Conoce nuestros proyectos con Norandino y Agronutrición."
  canonicalUrl={Astro.url.href}
  ogType="website"
  mainPadding={false}
>
  <BreadcrumbSchema items={[
    { name: "Inicio", url: "https://esva.pe/" },
    { name: "Proyectos Empresariales", url: "https://esva.pe/proyectos-empresariales/" }
  ]} />

  <Hero
    title="Proyectos Empresariales"
    subtitle="Diseñamos e implementamos infraestructura tecnológica completa para empresas: redes, servidores, seguridad electrónica y telefonía, integrados en un solo proyecto."
    imageUrl="/TecnicoESVA-RedesConectividad.jpg"
    buttonText="Conversemos tu proyecto"
    buttonLink="Escríbenos por WhatsApp"
    linkwhatsapp={whatsappLink}
    imageMaxWidth="max-w-xl"
    sectionPadding="pt-6 pb-12 md:pt-10 md:pb-24"
  />

  <!-- Intro: de soporte puntual a infraestructura integral -->
  <section class="bg-white py-16">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <div class="flex items-center justify-center gap-3 mb-6">
        <Building2 className="w-8 h-8 text-blue-700" />
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Más que instalaciones puntuales</h2>
      </div>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Además de soporte técnico y servicios individuales, en ESVA diseñamos e implementamos
        proyectos de infraestructura tecnológica completa para empresas e instituciones: redes
        corporativas, servidores, seguridad perimetral, videovigilancia y telefonía IP,
        trabajados como un solo sistema en vez de contrataciones separadas. Para proyectos que
        lo requieren, entregamos también documentación técnica (memoria descriptiva,
        especificaciones, matriz de cobertura) pensada para tus propios procesos de auditoría o
        certificación.
      </p>
    </div>
  </section>

  <!-- Casos de proyectos -->
  <section class="bg-slate-50 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8 text-center">Proyectos en marcha</h2>

      <div class="flex flex-wrap justify-center gap-2 mb-12">
        <button type="button" class="estado-filter px-4 py-2 rounded-full text-sm font-semibold border transition bg-blue-700 text-white border-blue-700" data-estado-filter="todos">
          Todos
        </button>
        <button type="button" class="estado-filter px-4 py-2 rounded-full text-sm font-semibold border transition bg-white text-gray-700 border-gray-300 hover:border-blue-400" data-estado-filter="instalado">
          Instalado
        </button>
        <button type="button" class="estado-filter px-4 py-2 rounded-full text-sm font-semibold border transition bg-white text-gray-700 border-gray-300 hover:border-blue-400" data-estado-filter="en-desarrollo">
          En desarrollo
        </button>
        <button type="button" class="estado-filter px-4 py-2 rounded-full text-sm font-semibold border transition bg-white text-gray-700 border-gray-300 hover:border-blue-400" data-estado-filter="en-ejecucion">
          En ejecución
        </button>
      </div>

      <div id="proyectos-grid" class="grid grid-cols-1 gap-10 lg:grid-cols-2">
        <!-- Caso Solux Group SAC -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 flex flex-col" data-estado="instalado">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full flex items-center justify-center p-2" style="background-color:#0247B6;">
                <img src="/LogoSolux.svg" alt="Logo de Solux Group SAC" class="w-full h-full object-contain" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">Solux Group SAC</h3>
                <p class="text-sm text-gray-500">Inspección de infraestructura eléctrica con drones</p>
              </div>
            </div>
            <span class="text-xs font-semibold text-green-700 bg-green-100 px-3 py-1 rounded-full whitespace-nowrap">Instalado</span>
          </div>

          <div class="space-y-4 text-gray-700">
            <div>
              <p class="font-semibold text-gray-900">El reto</p>
              <p>
                Solux realiza inspecciones termográficas de líneas eléctricas y subestaciones con
                drones, usando sus camionetas como base de operaciones en campo. Muchas de estas
                inspecciones ocurren en zonas rurales o alejadas, sin cobertura celular confiable
                para transmitir datos ni coordinar el trabajo en tiempo real.
              </p>
            </div>
            <div>
              <p class="font-semibold text-gray-900">La solución</p>
              <p>
                Instalamos antenas Starlink Mini en sus camionetas de trabajo, dándoles internet
                satelital portátil para operar y transmitir información desde cualquier punto de
                campo, sin depender de la señal celular de la zona.
              </p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2 mt-6">
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">Starlink Mini</span>
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">Conectividad móvil</span>
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">Trabajo de campo</span>
          </div>

          <a href="https://solux.pe" target="_blank" rel="noopener noreferrer" class="inline-block text-sm font-medium text-blue-600 hover:text-blue-800 mt-4">
            Conoce más sobre Solux &rarr;
          </a>

          <GaleriaCarrusel
            fotos={galeriaSolux}
            galeria="solux"
          />
        </div>

        <!-- Caso Agronutrición -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 flex flex-col" data-estado="en-desarrollo">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                <Network className="w-6 h-6 text-blue-700" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">Agronutrición</h3>
                <p class="text-sm text-gray-500">Infraestructura tecnológica corporativa integral</p>
              </div>
            </div>
            <span class="text-xs font-semibold text-blue-700 bg-blue-100 px-3 py-1 rounded-full whitespace-nowrap">En desarrollo</span>
          </div>

          <div class="space-y-4 text-gray-700">
            <div>
              <p class="font-semibold text-gray-900">El reto</p>
              <p>
                Construir desde cero toda la infraestructura tecnológica de la empresa: sin red
                corporativa, sin servidores propios y sin seguridad electrónica instalada.
              </p>
            </div>
            <div>
              <p class="font-semibold text-gray-900">La solución</p>
              <p>
                Implementación integral en curso: red corporativa e internet, WiFi empresarial,
                servidores, firewall perimetral, cámaras de seguridad, instalación y configuración
                de computadoras, y centralita telefónica IP — todo diseñado como un solo sistema
                para escalar junto con la empresa.
              </p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2 mt-6">
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">Cisco</span>
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">Mikrotik</span>
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">Servidores</span>
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">Firewall</span>
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">Telefonía IP</span>
            <span class="text-xs font-medium bg-gray-100 text-gray-700 px-3 py-1 rounded-full">CCTV</span>
          </div>

          <GaleriaCarrusel
            fotos={galeriaAgronutricion}
            galeria="agronutricion"
          />
        </div>

        <!-- Caso Norandino -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8 flex flex-col" data-estado="en-ejecucion">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                <Camera className="w-6 h-6 text-blue-700" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">Norandino</h3>
                <p class="text-sm text-gray-500">Organización asociativa de agricultores &middot; Planta de café</p>
              </div>
            </div>
            <span class="text-xs font-semibold text-blue-700 bg-blue-100 px-3 py-1 rounded-full whitespace-nowrap">En ejecución</span>
          </div>

          <div class="space-y-4 text-gray-700">
            <div>
              <p class="font-semibold text-gray-900">El reto</p>
              <p>
                Vigilar y controlar el acceso en una planta de procesamiento de café, cubriendo
                puntos críticos y zonas restringidas bajo criterios de seguridad y trazabilidad
