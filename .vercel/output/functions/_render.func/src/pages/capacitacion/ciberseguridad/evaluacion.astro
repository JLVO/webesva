---
import PresentacionLayout from '../../../layouts/PresentacionLayout.astro';
import EvaluacionForm from '../../../components/EvaluacionForm.jsx';
---

<PresentacionLayout
  pageTitle="Evaluación Final"
  currentPage={11}
  totalPages={12}
  prevPage="/capacitacion/ciberseguridad/buenas-practicas"
  nextPage="/capacitacion/ciberseguridad/conclusion"
>
  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold text-gray-800">Evaluación Final</h1>
    <p class="text-lg text-gray-600 mt-2 max-w-3xl mx-auto">
      Por favor, completa este breve formulario. Tu feedback es esencial para medir la efectividad de esta capacitación y mejorar las futuras.
    </p>
  </div>

  <div class="max-w-4xl mx-auto">
    <EvaluacionForm client:load />
  </div>
</PresentacionLayout>