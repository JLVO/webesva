---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Soporte Técnico Informático en Piura | ESVA";
const metaDescription = "Obtén el mejor soporte técnico informático en Piura con ESVA. Reparación, mantenimiento, instalación de redes y asistencia remota para tus computadoras y sistemas. ¡Soluciones rápidas y confiables!";
---

<BaseLayout pageTitle={pageTitle} metaDescription={metaDescription}>
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Soporte Técnico Informático en Piura</h1>
      <p class="text-lg md:text-xl text-gray-700 max-w-3xl mx-auto mb-12">
        En ESVA, somos tu aliado tecnológico de confianza en Piura. Ofrecemos soluciones integrales de soporte técnico para garantizar el óptimo funcionamiento de tus equipos y sistemas.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 text-left">
        <div class="bg-gray-50 p-8 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
          <h2 class="text-2xl font-semibold text-blue-700 mb-4">Diagnóstico y Reparación</h2>
          <p class="text-gray-600 mb-4">
            Identificamos y solucionamos cualquier problema de hardware o software en tus computadoras, laptops y servidores.
          </p>
          <ul class="list-disc list-inside text-gray-600">
            <li>Reparación de componentes</li>
            <li>Eliminación de virus y malware</li>
            <li>Solución de errores de sistema</li>
            <li>Recuperación de datos (si es posible)</li>
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
          <h2 class="text-2xl font-semibold text-blue-700 mb-4">Mantenimiento Preventivo</h2>
          <p class="text-gray-600 mb-4">
            Asegura la longevidad y el rendimiento de tus equipos con nuestros planes de mantenimiento.
          </p>
          <ul class="list-disc list-inside text-gray-600">
            <li>Limpieza interna y externa</li>
            <li>Optimización del sistema operativo</li>
            <li>Actualización de drivers y software</li>
            <li>Verificación de seguridad</li>
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
          <h2 class="text-2xl font-semibold text-blue-700 mb-4">Instalación y Configuración</h2>
          <p class="text-gray-600 mb-4">
            Te ayudamos con la puesta en marcha de nuevos equipos, software y periféricos.
          </p>
          <ul class="list-disc list-inside text-gray-600">
            <li>Instalación de Windows, macOS, Linux</li>
            <li>Configuración de impresoras y escáneres</li>
            <li>Instalación de programas específicos</li>
            <li>Configuración de redes domésticas/empresariales</li>
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
          <h2 class="text-2xl font-semibold text-blue-700 mb-4">Soporte Remoto y a Domicilio</h2>
          <p class="text-gray-600 mb-4">
            Ofrecemos asistencia flexible para adaptarnos a tus necesidades.
          </p>
          <ul class="list-disc list-inside text-gray-600">
            <li>Asistencia técnica vía remota</li>
            <li>Visitas a domicilio en Piura y alrededores</li>
            <li>Soporte para empresas y hogares</li>
            <li>Respuesta rápida ante emergencias</li>
          </ul>
        </div>
      </div>

      <div class="mt-12">
        <a href="https://wa.me/51985834886?text=Hola%20ESVA%2C%20necesito%20soporte%20t%C3%A9cnico%20en%20Piura." 
           target="_blank" 
           class="inline-flex items-center gap-3 bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-full shadow-lg text-lg font-semibold transition duration-300 transform hover:scale-105">
          <i class="fab fa-whatsapp"></i>
          Contáctanos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>